@model PhysioLink.AdminPanel.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="stats-row">
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004AAD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
        <div class="stat-label">Total Patients</div>
        <div class="stat-value">@Model.PatientCount</div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004AAD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
        </div>
        <div class="stat-label">Active Assignments</div>
        <div class="stat-value">@Model.ActiveAssignment</div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004AAD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
        </div>
        <div class="stat-label">This Week's Appointments</div>
        <div class="stat-value">@Model.ThisWeekAppointments</div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004AAD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2z"/><path d="M6 21v-1a6 6 0 0 1 6-6h.5"/>
                <path d="M18 21v-6m-3 3h6"/>
            </svg>
        </div>
        <div class="stat-label">Total Therapists</div>
        <div class="stat-value">@Model.TherapistCount</div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="card">
        <div class="card-header">
            <div class="card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#323232" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>Upcoming Appointments</div>
            <a asp-controller="Appointments" asp-action="Index" class="card-link">View all</a>
        </div>
        @if (Model.UpcomingAppointments.Count == 0)
        {
            <p style="color:#8E8E93; font-size:14px; padding:16px 0; margin:0;">No upcoming appointments.</p>
        }
        else
        {
            <ul style="list-style:none; margin:0; padding:0;">
                @foreach (var appt in Model.UpcomingAppointments)
                {
                    <li style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:0.5px solid #f2f2f7;">
                        <div>
                            <p style="font-weight:500; font-size:14px; color:#323232; margin:0;">@appt.Title</p>
                            <p style="font-size:12px; color:#8E8E93; margin:3px 0 0;">@appt.PatientName · @appt.AppointmentTime.ToString("MMM d, h:mm tt")</p>
                        </div>
                        <span style="font-size:12px; font-weight:500; padding:3px 10px; border-radius:20px;
                            background:@(appt.Status == "Confirmed" ? "#e8f0fb" : appt.Status == "Completed" ? "#e8f5ee" : appt.Status == "Cancelled" ? "#ffeaea" : "#fff3e0");
                            color:@(appt.Status == "Confirmed" ? "#004AAD" : appt.Status == "Completed" ? "#2e7d52" : appt.Status == "Cancelled" ? "#FF3B30" : "#e65100");">
                            @appt.Status
                        </span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#323232" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>Recent Patients</div>
            <a asp-controller="Patients" asp-action="Index" class="card-link">View all</a>
        </div>
        @if (Model.RecentPatients.Count == 0)
        {
            <p style="color:#8E8E93; font-size:14px; padding:16px 0; margin:0;">No patients yet.</p>
        }
        else
        {
            <ul style="list-style:none; margin:0; padding:0;">
                @foreach (var patient in Model.RecentPatients)
                {
                    <li style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:0.5px solid #f2f2f7;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div style="width:34px; height:34px; border-radius:50%; background:#e8f0fb; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:12px; color:#004AAD;">
                                @patient.FirstName[0]@patient.LastName[0]
                            </div>
                            <div>
                                <p style="font-weight:500; font-size:14px; color:#323232; margin:0;">@patient.FirstName @patient.LastName</p>
                                <p style="font-size:12px; color:#8E8E93; margin:3px 0 0;">@patient.Diagnosis</p>
                            </div>
                        </div>
                        @await Html.PartialAsync("_StatusBadge", patient.IsActive ? "Active" : "Inactive")
                    </li>
                }
            </ul>
        }
    </div>
</div>