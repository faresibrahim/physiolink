@model PhysioLink.AdminPanel.ViewModels.DashboardViewModel
@using PhysioLink.AdminPanel.Helpers

@{
    ViewData["Title"] = "Dashboard";

    var hour = ClinicTime.ToLocal(DateTime.UtcNow).Hour;
    var greeting = L[hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening"].Value;
    var clinicName = User.FindFirst("ClinicName")?.Value;
}

<div class="hero">
    <div>
        <h1 class="hero-title">@(string.IsNullOrWhiteSpace(clinicName) ? greeting : L["{0}, {1}", greeting, clinicName].Value)</h1>
        <p class="hero-sub">@L["Here's what's happening at your clinic today."]</p>
    </div>
    <span class="hero-date">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
        @ClinicTime.ToLocal(DateTime.UtcNow).ToString(DatePatterns.WeekdayMonthDay)
    </span>
</div>

<div class="stats-row">
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
        <div class="stat-body">
            <p class="stat-label">@L["Total Patients"]</p>
            <div class="stat-value">@Model.PatientCount</div>
        </div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
        </div>
        <div class="stat-body">
            <p class="stat-label">@L["Active Assignments"]</p>
            <div class="stat-value">@Model.ActiveAssignment</div>
        </div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
        </div>
        <div class="stat-body">
            <p class="stat-label">@L["Today's Appointments"]</p>
            <div class="stat-value">@Model.TodayAppointments</div>
        </div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2z"/><path d="M6 21v-1a6 6 0 0 1 6-6h.5"/>
                <path d="M18 21v-6m-3 3h6"/>
            </svg>
        </div>
        <div class="stat-body">
            <p class="stat-label">@L["Total Therapists"]</p>
            <div class="stat-value">@Model.TherapistCount</div>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                @L["Upcoming Appointments"]
                @if (Model.UpcomingAppointments.Count > 0)
                {
                    <span class="count-badge">@Model.UpcomingAppointments.Count</span>
                }
            </h3>
            <a asp-controller="Appointments" asp-action="Index" class="card-link">@L["View all"]</a>
        </div>
        @if (Model.UpcomingAppointments.Count == 0)
        {
            <p class="list-empty">@L["No upcoming appointments."]</p>
        }
        else
        {
            <ul class="row-list">
                @foreach (var appt in Model.UpcomingAppointments)
                {
                    var local = ClinicTime.ToLocal(appt.AppointmentTime);
                    <li class="row-item">
                        <div class="row-lead">
                            <div class="appt-when">
                                <span class="appt-when-time">@local.ToString("h:mm tt")</span>
                                <span class="appt-when-day">@L[ClinicTime.DayLabel(local)]</span>
                            </div>
                            <div>
                                <p class="row-title">@appt.Title</p>
                                <p class="row-meta">@appt.PatientName</p>
                            </div>
                        </div>
                        @await Html.PartialAsync("_StatusBadge", appt.Status)
                    </li>
                }
            </ul>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                @L["Recent Patients"]
                @if (Model.RecentPatients.Count > 0)
                {
                    <span class="count-badge">@Model.RecentPatients.Count</span>
                }
            </h3>
            <a asp-controller="Patients" asp-action="Index" class="card-link">@L["View all"]</a>
        </div>
        @if (Model.RecentPatients.Count == 0)
        {
            <p class="list-empty">@L["No patients yet."]</p>
        }
        else
        {
            <ul class="row-list">
                @foreach (var patient in Model.RecentPatients)
                {
                    <li class="row-item">
                        <div class="row-lead">
                            <svg class="patient-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <div>
                                <p class="row-title">@patient.FirstName @patient.LastName</p>
                                <p class="row-meta">@patient.Diagnosis</p>
                            </div>
                        </div>
                        @await Html.PartialAsync("_StatusBadge", patient.IsActive ? "Active" : "Inactive")
                    </li>
                }
            </ul>
        }
    </div>
</div>
