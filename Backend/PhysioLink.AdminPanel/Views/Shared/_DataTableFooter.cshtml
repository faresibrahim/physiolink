@model PhysioLink.AdminPanel.ViewModels.Shared.DataTableFooterViewModel
@* Data-table card footer (datatable-export design): entry count on one side,
   first / previous / up to five page numbers / next / last on the other.
   Renders nothing when there are no entries. *@
@if (Model.TotalCount > 0)
{
    var pager = Model.Pagination;
    var firstEntry = (pager.CurrentPage - 1) * Model.PageSize + 1;
    var lastEntry = firstEntry + Model.ItemCount - 1;
    var totalPages = Math.Max(1, pager.TotalPages);
    // Up to five page numbers, kept around the current page.
    var windowEnd = Math.Min(totalPages, Math.Max(pager.CurrentPage + 2, 5));
    var windowStart = Math.Max(1, windowEnd - 4);
    var onFirst = pager.CurrentPage <= 1;
    var onLast = pager.CurrentPage >= totalPages;

    string PageUrl(int p)
    {
        var routeValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary(pager.Filters.ToDictionary(kv => kv.Key, kv => (object?)kv.Value))
        {
            ["page"] = p
        };
        return Url.Action(pager.ActionName, routeValues) ?? "#";
    }

    <div class="dt-footer">
        <span class="dt-count">@L["Showing {0} to {1} of {2} entries", firstEntry, lastEntry, Model.TotalCount]</span>

        <nav aria-label="@L["Pagination"]">
            <ul class="dt-pagination">
                <li class="@(onFirst ? "is-disabled" : "")">
                    <a class="dt-page dt-page-icon" href="@(onFirst ? null : PageUrl(1))" aria-label="@L["First page"]" aria-disabled="@(onFirst ? "true" : null)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17-5-5 5-5" /><path d="m18 17-5-5 5-5" /></svg>
                    </a>
                </li>
                <li class="@(onFirst ? "is-disabled" : "")">
                    <a class="dt-page dt-page-icon" href="@(onFirst ? null : PageUrl(pager.CurrentPage - 1))" aria-label="@L["Previous page"]" aria-disabled="@(onFirst ? "true" : null)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                    </a>
                </li>
                @for (var p = windowStart; p <= windowEnd; p++)
                {
                    <li class="@(p == pager.CurrentPage ? "is-active" : "")">
                        <a class="dt-page" href="@PageUrl(p)" aria-current="@(p == pager.CurrentPage ? "page" : null)">@p</a>
                    </li>
                }
                <li class="@(onLast ? "is-disabled" : "")">
                    <a class="dt-page dt-page-icon" href="@(onLast ? null : PageUrl(pager.CurrentPage + 1))" aria-label="@L["Next page"]" aria-disabled="@(onLast ? "true" : null)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                    </a>
                </li>
                <li class="@(onLast ? "is-disabled" : "")">
                    <a class="dt-page dt-page-icon" href="@(onLast ? null : PageUrl(totalPages))" aria-label="@L["Last page"]" aria-disabled="@(onLast ? "true" : null)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 17 5-5-5-5" /><path d="m13 17 5-5-5-5" /></svg>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
