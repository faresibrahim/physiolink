@model PhysioLink.AdminPanel.ViewModels.Shared.PaginationViewModel

@*If there is only 1 page, then don't render anything*@
@if (Model.TotalPages > 1)
{
    int windowSize = 1;
    int start = Math.Max(2, Model.CurrentPage - windowSize);
    int end   = Math.Min(Model.TotalPages - 1, Model.CurrentPage + windowSize);

    // Build URL for a given page, preserving all active filters
    string PageUrl(int p)
    {
        var rv = new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.Filters.ToDictionary(kv => kv.Key, kv => (object?)kv.Value))
        {
            ["page"] = p
        };
        return Url.Action(Model.ActionName, rv) ?? "#";
    }

    <nav class="pagination-row" aria-label="Pagination">

        @* ── Prev ── *@
        @if (Model.CurrentPage > 1)
        {
            <a href="@PageUrl(Model.CurrentPage - 1)" class="page-btn page-btn-nav" aria-label="Previous page">
                <span aria-hidden="true">←</span><span>Prev</span>
            </a>
        }
        else
        {
            <span class="page-btn page-btn-nav page-btn-disabled" aria-disabled="true">
                <span aria-hidden="true">←</span><span>Prev</span>
            </span>
        }

        @* ── First page ── *@
        <a href="@PageUrl(1)" class="page-btn @(1 == Model.CurrentPage ? "page-btn-active" : "")">1</a>

        @if (start > 2)
        {
            <span class="page-ellipsis">…</span>
        }

        @* ── Middle pages ── *@
        @for (int i = start; i <= end; i++)
        {
            <a href="@PageUrl(i)" class="page-btn @(i == Model.CurrentPage ? "page-btn-active" : "")">@i</a>
        }

        @if (end < Model.TotalPages - 1)
        {
            <span class="page-ellipsis">…</span>
        }

        @* ── Last page (only when TotalPages > 1, already guarded above) ── *@
        <a href="@PageUrl(Model.TotalPages)"
           class="page-btn @(Model.TotalPages == Model.CurrentPage ? "page-btn-active" : "")">@Model.TotalPages</a>

        @* ── Next ── *@
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a href="@PageUrl(Model.CurrentPage + 1)" class="page-btn page-btn-nav" aria-label="Next page">
                <span>Next</span><span aria-hidden="true">→</span>
            </a>
        }
        else
        {
            <span class="page-btn page-btn-nav page-btn-disabled" aria-disabled="true">
                <span>Next</span><span aria-hidden="true">→</span>
            </span>
        }
    </nav>
}
