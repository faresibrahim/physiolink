@* =========================================================================
   EXERCISE DETAIL MODAL (shared)
   Read-only video + description for a single exercise, loaded on demand from
   /Exercises/GetJson/{id}. Included by the Exercise Library page and the
   patient assign-exercise picker. Exposes window.openExerciseModal(id).
   ========================================================================= *@
<div class="modal-overlay" id="exerciseDetailModal" aria-modal="true" role="dialog" aria-labelledby="exerciseModalTitle">
    <div class="modal modal-lg">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="exerciseModalTitle">Exercise Detail</h2>
            </div>
            <button type="button" class="modal-close" onclick="closeExerciseModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        @* Loading state *@
        <div id="exerciseModalLoading" class="modal-loading">Loading...</div>

        @* Content (hidden until loaded) *@
        <div id="exerciseModalContent" class="modal-body" style="display:none;">

            @* Video player — iframe for YouTube IDs, <video> for direct/local files *@
            <div id="exerciseVideoSection">
                <div class="video-frame">
                    <iframe id="exerciseVideoFrame"
                            src=""
                            title="Exercise demonstration"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                    <video id="exerciseVideoFile"
                           src=""
                           title="Exercise demonstration"
                           controls
                           preload="metadata"
                           playsinline
                           style="display:none;"></video>
                </div>
            </div>

            @* No video placeholder *@
            <div id="exerciseNoVideo" class="video-empty" style="display:none;">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <p>No demonstration video for this exercise yet.</p>
            </div>

            @* Description *@
            <p id="exerciseModalDescription" class="modal-description"></p>

            @* Arabic translation of the steps — hidden when the exercise has none *@
            <p id="exerciseModalDescriptionAr"
               class="modal-description modal-description-ar"
               lang="ar" dir="rtl"
               style="display:none;"></p>

            @* Divider *@
            <div class="modal-divider"></div>

            @* Difficulty — sets/reps/duration are patient-specific and only
               shown once an exercise is assigned, not in the library. *@
            <span class="difficulty-pill" id="exerciseModalDifficulty">
                <span class="difficulty-dot"></span>
                <span id="exerciseModalDifficultyText"></span>
            </span>
        </div>

    </div>
</div>

<script>
(function () {
    var modal     = document.getElementById('exerciseDetailModal');
    var loading   = document.getElementById('exerciseModalLoading');
    var content   = document.getElementById('exerciseModalContent');
    var iframe    = document.getElementById('exerciseVideoFrame');
    var videoFile = document.getElementById('exerciseVideoFile');
    var videoSec  = document.getElementById('exerciseVideoSection');
    var noVideo   = document.getElementById('exerciseNoVideo');

    // A direct file source (local upload or full media URL) vs a YouTube video id.
    function isDirectVideo(url) {
        return url.charAt(0) === '/' || /\.(mp4|mov|webm|ogg|m4v)(\?|#|$)/i.test(url);
    }

    // Accepts a bare YouTube id or a full youtu.be / youtube.com URL and returns just the id.
    function extractYouTubeId(url) {
        var match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|watch\?v=|shorts\/))([^?&#/]+)/i);
        return match ? match[1] : url;
    }

    // Mirrors the difficultyClass switch in the Razor loop above, for cards
    // rendered client-side from the fetched detail JSON.
    function difficultyClass(difficulty) {
        switch (difficulty) {
            case 'Easy':     return 'diff-beginner';
            case 'Moderate': return 'diff-intermediate';
            case 'Hard':     return 'diff-advanced';
            default:         return 'diff-neutral';
        }
    }

    async function openExerciseModal(id) {
        // Reset state
        loading.textContent    = 'Loading...';
        loading.style.display  = 'block';
        content.style.display  = 'none';
        iframe.src             = '';
        videoFile.pause();
        videoFile.removeAttribute('src');
        videoFile.load();
        videoFile.style.display = 'none';
        iframe.style.display    = 'none';
        modal.classList.add('modal-visible');

        try {
            // Goes through the panel's own controller — same origin, HttpOnly auth cookie
            // is sent automatically; the panel forwards to the API server-side.
            var response = await fetch('/Exercises/GetJson/' + id, {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });

            if (!response.ok) {
                loading.textContent = 'Could not load exercise.';
                return;
            }

            var data = await response.json();

            // Title
            document.getElementById('exerciseModalTitle').textContent = data.name;

            // Video — direct file plays in a <video>, otherwise treat as a YouTube id
            if (data.videoUrl) {
                videoSec.style.display = 'block';
                noVideo.style.display  = 'none';
                if (isDirectVideo(data.videoUrl)) {
                    videoFile.src        = data.videoUrl;
                    videoFile.style.display = 'block';
                    iframe.style.display    = 'none';
                } else {
                    iframe.src           = 'https://www.youtube.com/embed/' + extractYouTubeId(data.videoUrl);
                    iframe.style.display    = 'block';
                    videoFile.style.display = 'none';
                }
            } else {
                videoSec.style.display = 'none';
                noVideo.style.display  = 'flex';
            }

            // Description + stats
            document.getElementById('exerciseModalDescription').textContent = data.description;

            var descAr = document.getElementById('exerciseModalDescriptionAr');
            if (data.descriptionAr) {
                descAr.textContent   = data.descriptionAr;
                descAr.style.display = 'block';
            } else {
                descAr.textContent   = '';
                descAr.style.display = 'none';
            }

            var difficultyPill = document.getElementById('exerciseModalDifficulty');
            difficultyPill.className = 'difficulty-pill ' + difficultyClass(data.difficulty);
            document.getElementById('exerciseModalDifficultyText').textContent = (data.difficulty || '').toUpperCase();

            loading.style.display = 'none';
            content.style.display = 'flex';

        } catch (err) {
            console.error('[exercise-modal]', err);
            loading.textContent = 'Could not load exercise.';
        }
    }

    function closeExerciseModal() {
        modal.classList.remove('modal-visible');
        iframe.src = ''; // stops YouTube audio
        videoFile.pause(); // stops local file playback
    }

    // Deliberately no overlay-click-to-close: closing should be an explicit
    // choice, not a stray click while viewing exercise details.

    // Expose for onclick
    window.openExerciseModal  = openExerciseModal;
    window.closeExerciseModal = closeExerciseModal;
})();
</script>
