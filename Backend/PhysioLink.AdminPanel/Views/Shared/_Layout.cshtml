@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="@(PanelLanguages.IsArabic ? "ar" : "en")" dir="@(PanelLanguages.IsArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L[ViewData["Title"]?.ToString() ?? ""] - @L["PhysioLink Admin"]</title>
    <link rel="icon" type="image/svg+xml" href="~/images/physiolink_logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/physiolink.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js" defer></script>
    @* Strings site.js builds messages from *@
    <script>window.plI18n = @Json.Serialize(new { required = L["{0} is required."].Value });</script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/sidebar.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main-content">@L["Skip to content"]</a>
    <div class="app">

        @* Sidebar — light "menu" design (adapted from the Sneat admin sidebar in
           sidebar-export/). Fixed column at 1200px and up; below that it slides
           in from the left, opened by the hamburger in .mobile-bar. *@
        <aside id="layout-menu" class="layout-menu" aria-label="@L["Main navigation"]">
            <div class="app-brand">
                <a asp-action="Index" asp-controller="Dashboard" class="app-brand-link">
                    <img class="app-brand-logo" src="~/images/physiolink_logo.svg" alt="" width="40" height="40" />
                    <span class="app-brand-text">PhysioLink</span>
                </a>
                <button type="button" class="layout-menu-close" data-menu-toggle aria-label="@L["Close menu"]">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                </button>
            </div>

            <nav class="menu-scroll">
                <ul class="menu-inner">
                    <li class="menu-header"><span class="menu-header-text">@L["Workspace"]</span></li>
                    <li class="menu-item @(currentController == "Dashboard" ? "active" : "")">
                        <a asp-action="Index" asp-controller="Dashboard" class="menu-link"
                           aria-current="@(currentController == "Dashboard" ? "page" : null)">
                            <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                            <span class="menu-text">@L["Dashboard"]</span>
                        </a>
                    </li>
                    <li class="menu-item @(currentController == "Patients" ? "active" : "")">
                        <a asp-action="Index" asp-controller="Patients" class="menu-link"
                           aria-current="@(currentController == "Patients" ? "page" : null)">
                            <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                            <span class="menu-text">@L["Patients"]</span>
                        </a>
                    </li>
                    <li class="menu-item @(currentController == "Therapists" ? "active" : "")">
                        <a asp-action="Index" asp-controller="Therapists" class="menu-link"
                           aria-current="@(currentController == "Therapists" ? "page" : null)">
                            <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M11 2v2" /><path d="M5 2v2" /><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1" /><path d="M8 15a6 6 0 0 0 12 0v-3" /><circle cx="20" cy="10" r="2" /></svg>
                            <span class="menu-text">@L["Therapists"]</span>
                        </a>
                    </li>
                    <li class="menu-item @(currentController == "Exercises" ? "active" : "")">
                        <a asp-action="Index" asp-controller="Exercises" class="menu-link"
                           aria-current="@(currentController == "Exercises" ? "page" : null)">
                            <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14.4 14.4 9.6 9.6" /><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.768 1.768a2 2 0 1 1-2.828-2.829l6.364-6.364a2 2 0 1 1 2.829 2.828l1.767-1.767a2 2 0 1 1 2.829 2.829z" /></svg>
                            <span class="menu-text">@L["Exercises"]</span>
                        </a>
                    </li>
                    <li class="menu-item @(currentController == "Appointments" && currentAction != "Requests" ? "active" : "")">
                        <a asp-action="Index" asp-controller="Appointments" class="menu-link"
                           aria-current="@(currentController == "Appointments" && currentAction != "Requests" ? "page" : null)">
                            <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4" /><path d="M8 2v4" /><path d="M3 10h18" /></svg>
                            <span class="menu-text">@L["Appointments"]</span>
                        </a>
                    </li>
                    @await Component.InvokeAsync("RequestsNav")
                </ul>
            </nav>

            <div class="menu-footer">
                <div class="menu-clinic">
                    <span class="menu-clinic-dot" aria-hidden="true"></span>
                    <div class="menu-clinic-body">
                        <div class="menu-clinic-name">@User.FindFirst("ClinicName")?.Value</div>
                        <div class="menu-clinic-meta">@L["Online"]</div>
                    </div>
                </div>
                @* Language switch — the first-visit choice can be changed here any time *@
                <form asp-action="Set" asp-controller="Language" method="post">
                    <input type="hidden" name="culture" value="@(PanelLanguages.IsArabic ? PanelLanguages.English : PanelLanguages.Arabic)" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="menu-link menu-language" lang="@(PanelLanguages.IsArabic ? "en" : "ar")" aria-label="@L["Change language"]: @(PanelLanguages.IsArabic ? "English" : "العربية")">
                        <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                        <span class="menu-text">@(PanelLanguages.IsArabic ? "English" : "العربية")</span>
                    </button>
                </form>
                <form asp-action="Logout" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="menu-link menu-logout">
                        <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg>
                        <span class="menu-text">@L["Log out"]</span>
                    </button>
                </form>
            </div>
        </aside>

        @* Dark backdrop behind the open sidebar on small screens; tap to close *@
        <div class="layout-overlay" data-menu-toggle aria-hidden="true"></div>

        <main class="main" id="main-content">
            @* Small screens only: the sidebar is off-canvas, so this bar holds
               the button that opens it. Hidden at 1200px and up. *@
            <div class="mobile-bar">
                <button type="button" class="mobile-bar-toggle" data-menu-toggle data-menu-open
                        aria-controls="layout-menu" aria-expanded="false" aria-label="@L["Open menu"]">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
                </button>
                <a asp-action="Index" asp-controller="Dashboard" class="mobile-bar-brand">
                    <img src="~/images/physiolink_logo.svg" alt="" width="32" height="32" />
                    <span>PhysioLink</span>
                </a>
            </div>
            @* Every page renders its own in-content header (title + subtitle +
               CTA), so the layout adds no chrome above the content. *@
            <div class="screens">
                @* Success fades on its own; an error waits to be dismissed, so the
                   admin can still read what failed after looking away. *@
                @if (TempData["SuccessMessage"] is string success)
                {
                    <div id="pl-toast-success" class="alert alert-success" role="status">
                        <div class="alert-icon">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                        </div>
                        @L[success]
                    </div>
                }
                @if (TempData["ErrorMessage"] is string error)
                {
                    <div id="pl-toast-error" class="alert alert-error" role="alert">
                        <div class="alert-icon">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                        </div>
                        @L[error]
                        <button type="button" class="alert-dismiss" aria-label="@L["Dismiss"]">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                        </button>
                    </div>
                }

                @RenderBody()
                @await RenderSectionAsync("Scripts", required: false)
            </div>
        </main>

    </div>
</body>
</html>
