@model LoginViewModel

@{
    Layout = null;
    // Arriving straight from the first-visit language screen: opt into the
    // view transition (logo + name glide into the card) or, without browser
    // support, play the card's own entrance animation.
    var fromPicker = TempData["FromLanguagePicker"] is bool picked && picked;
}
<!DOCTYPE html>
<html lang="@(PanelLanguages.IsArabic ? "ar" : "en")" dir="@(PanelLanguages.IsArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Sign in"] - @L["PhysioLink Admin"]</title>
    <link rel="icon" type="image/svg+xml" href="~/images/physiolink_logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/physiolink.css" asp-append-version="true" />
    <script src="~/js/login.js" asp-append-version="true" defer></script>
    @if (fromPicker)
    {
        <style>
            @@view-transition { navigation: auto; }
            ::view-transition-old(root) { animation: 0.3s ease both pl-vt-out; }
            ::view-transition-new(root) { animation: 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.08s both pl-vt-in; }
            ::view-transition-group(pl-logo),
            ::view-transition-group(pl-wordmark) { animation-duration: 0.6s; animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }
            @@keyframes pl-vt-out { to { opacity: 0; transform: scale(0.98); } }
            @@keyframes pl-vt-in { from { opacity: 0; transform: translateY(12px); } }
            @@media (prefers-reduced-motion: reduce) {
                ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
            }
        </style>
        <script>if (!('onpagereveal' in window)) document.documentElement.classList.add('auth-enter');</script>
    }
</head>

<body class="auth-body">
@* Login — adapted from the Sneat "Login Basic" page (login-export/): centred
   card on a light page with two dotted shapes peeking out behind it. *@
<main class="auth-wrapper">
    <div class="auth-inner">
        <div class="auth-card">

            <div class="auth-brand">
                <img class="auth-brand-logo" src="~/images/physiolink_logo.svg" alt="" width="44" height="44" />
                <span class="auth-brand-text">PhysioLink</span>
            </div>

            <p class="auth-sub">@L["Please sign in to your clinic account to manage patients, therapists and scheduling."]</p>

            @if (TempData["ErrorMessage"] is string err)
            {
                <div class="alert alert-error auth-alert" role="alert">
                    <div class="alert-icon">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                    </div>
                    @L[err]
                </div>
            }

            <form asp-action="Login" asp-controller="Auth" method="post" class="auth-form">
                <div class="auth-field">
                    <label asp-for="Email" class="auth-label">@L["Email"]</label>
                    <input asp-for="Email" class="auth-input" type="email" placeholder="@L["Enter your email"]" autocomplete="email" required autofocus />
                </div>

                <div class="auth-field">
                    <label asp-for="Password" class="auth-label">@L["Password"]</label>
                    <div class="auth-input-group">
                        <input asp-for="Password" class="auth-input" type="password" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" autocomplete="current-password" required />
                        <button type="button" class="auth-password-toggle" data-password-toggle
                                aria-controls="Password" aria-label="@L["Show password"]" aria-pressed="false"
                                data-label-show="@L["Show password"]" data-label-hide="@L["Hide password"]">
                            @* Eye with a slash = password hidden (shown by default) *@
                            <svg class="icon-hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" /><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" /><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" /><path d="m2 2 20 20" /></svg>
                            <svg class="icon-shown" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </div>
                </div>

                <div class="auth-row">
                    <label class="auth-check">
                        <input asp-for="RememberMe" class="auth-check-input" />
                        <span>@L["Remember me"]</span>
                    </label>
                    @* No password-reset flow exists yet — this link has no destination. *@
                    <a href="#" class="auth-link">@L["Forgot password?"]</a>
                </div>

                <button type="submit" class="auth-submit">@L["Sign in"]</button>
            </form>

        </div>
    </div>

    @* Language switch for visitors who picked the wrong one on the first screen *@
    <form asp-action="Set" asp-controller="Language" method="post" class="auth-lang">
        <input type="hidden" name="culture" value="@(PanelLanguages.IsArabic ? PanelLanguages.English : PanelLanguages.Arabic)" />
        <input type="hidden" name="returnUrl" value="/Auth/Login" />
        <button type="submit" class="auth-lang-btn" lang="@(PanelLanguages.IsArabic ? "en" : "ar")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
            <span>@(PanelLanguages.IsArabic ? "English" : "العربية")</span>
        </button>
    </form>
</main>
</body>
</html>
