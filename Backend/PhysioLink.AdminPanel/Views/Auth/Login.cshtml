@model LoginViewModel

@{
    Layout = null;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - PhysioLink Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/physiolink_logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/physiolink.css" asp-append-version="true" />
</head>

<body>
<div class="auth-page">
    <div class="card auth-card">

        <div class="brand">
            <img src="~/images/physiolink_logo.svg" alt="" width="56" height="56" />
            <div>
                <div class="brand-name">PhysioLink</div>
                <div class="brand-sub">Admin Panel</div>
            </div>
        </div>

        <h1 class="auth-title">Sign in</h1>
        <p class="auth-sub">Patients, therapists and scheduling.</p>

        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-error" role="alert">
                <div class="alert-icon">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                </div>
                @err
            </div>
        }

        <form asp-action="Login" asp-controller="Auth" method="post" class="auth-form">
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="input" type="email" placeholder="admin@clinic.com" autocomplete="email" required autofocus />
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="input" type="password" placeholder="••••••••" autocomplete="current-password" required />
            </div>
            <label class="checkbox-label">
                <input asp-for="RememberMe" class="checkbox-input" />
                <span class="checkbox-text">Remember me</span>
            </label>
            <button type="submit" class="btn btn-primary btn-block">Sign in</button>
        </form>

    </div>
</div>
</body>
</html>
