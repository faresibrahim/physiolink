@model LoginViewModel

@{
    Layout = null;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - PhysioLink Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/physiolink_logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/physiolink.css" asp-append-version="true" />
</head>

<body>
<div class="auth-page">
    <div class="card auth-card">

        <div class="brand">
            <img src="~/images/physiolink_logo.svg" alt="PhysioLink" width="40" height="40" />
            <div>
                <div class="brand-name">PhysioLink</div>
                <div class="brand-sub">Admin Panel</div>
            </div>
        </div>

        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-sub">Sign in to manage your clinic</p>

        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-error" role="alert">@err</div>
        }

        <form asp-action="Login" asp-controller="Auth" method="post" class="auth-form">
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="input" type="email" placeholder="admin@clinic.com" autocomplete="email" />
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="input" type="password" placeholder="••••••••" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Sign in</button>
        </form>

    </div>
</div>
</body>
</html>
