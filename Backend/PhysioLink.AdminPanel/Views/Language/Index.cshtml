@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PhysioLink · Choose language · اختر اللغة</title>
    <link rel="icon" type="image/svg+xml" href="~/images/physiolink_logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/physiolink.css" asp-append-version="true" />
    @* Opts this page into a cross-document view transition, so the logo and name
       glide into the login card instead of the page simply swapping. *@
    <style>@@view-transition { navigation: auto; }</style>
    <script src="~/js/language.js" asp-append-version="true" defer></script>
</head>

<body class="lang-body">
@* First-visit language screen. Shown once per browser; the choice is stored in
   the culture cookie and drives the whole panel (text, direction, dates). *@
<main class="lang-stage" id="langStage">
    <div class="lang-backdrop" aria-hidden="true">
        <span class="lang-orb lang-orb-a"></span>
        <span class="lang-orb lang-orb-b"></span>
        <span class="lang-dots"></span>
    </div>

    <div class="lang-content">
        <img class="lang-logo lang-reveal" style="--i:0" src="~/images/physiolink_logo.svg" alt="" width="128" height="128" />

        <h1 class="lang-wordmark lang-reveal" style="--i:1">PhysioLink</h1>

        <p class="lang-tagline lang-reveal" style="--i:2">
            <span lang="en">Choose your language</span>
            <span class="lang-tagline-sep" aria-hidden="true"></span>
            <span lang="ar" dir="rtl">اختر لغتك</span>
        </p>

        <form asp-controller="Language" asp-action="Set" method="post" class="lang-options" id="langForm">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <input type="hidden" name="fromPicker" value="true" />

            <button type="submit" name="culture" value="@PanelLanguages.English"
                    class="lang-option lang-reveal" style="--i:3" lang="en" dir="ltr">
                <span class="lang-option-text">
                    <span class="lang-option-name">English</span>
                    <span class="lang-option-sub">Continue in English</span>
                </span>
            </button>

            <button type="submit" name="culture" value="@PanelLanguages.Arabic"
                    class="lang-option lang-reveal" style="--i:4" lang="ar" dir="rtl">
                <span class="lang-option-text">
                    <span class="lang-option-name">العربية</span>
                    <span class="lang-option-sub">المتابعة باللغة العربية</span>
                </span>
            </button>
        </form>

        <p class="lang-note lang-reveal" style="--i:5">
            <span lang="en">You can switch languages anytime.</span>
            <span lang="ar" dir="rtl">يمكنك تغيير اللغة في أي وقت.</span>
        </p>
    </div>
</main>
</body>
</html>
