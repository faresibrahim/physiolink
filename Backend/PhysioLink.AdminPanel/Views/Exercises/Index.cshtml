@model PhysioLink.AdminPanel.ViewModels.ExerciseListViewModel
@{
    ViewData["Title"] = "Exercises";
}

@* =========================================================================
   PAGE HEADER — title + subtitle (stat line)
   Create CTA is intentionally hidden — exercises are curated centrally.
   ========================================================================= *@
<div class="library-header">
    <div>
        <h1 style="font-size:1.5rem; font-weight:600; color:#323232; margin:0;">Exercise Library</h1>
        <p style="color:#8E8E93; margin:4px 0 0;">
            @Model.TotalCount exercises available.
        </p>
    </div>
</div>

@* =========================================================================
   FILTER BAR — search input + difficulty dropdown
   ========================================================================= *@
<section class="library-filters">
    @{
        bool allSelected      = string.IsNullOrEmpty(Model.DifficultyFilter);
        bool easySelected     = Model.DifficultyFilter == "Easy";
        bool moderateSelected = Model.DifficultyFilter == "Moderate";
        bool hardSelected     = Model.DifficultyFilter == "Hard";
    }
    <form method="get" asp-action="Index" class="filter-form">
        @* Preserve the active category when the user searches or changes difficulty *@
        <input type="hidden" name="category" value="@Model.CategoryFilter" />

        <div class="search-field">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text"
                   name="search"
                   value="@Model.SearchQuery"
                   placeholder="Search exercises..."
                   class="search-input"
                   autocomplete="off" />
        </div>

        <div class="select-field">
            <select name="difficulty" class="filter-select" onchange="this.form.submit()">
                <option value="" selected="@allSelected">All difficulties</option>
                <option value="Easy" selected="@easySelected">Easy</option>
                <option value="Moderate" selected="@moderateSelected">Moderate</option>
                <option value="Hard" selected="@hardSelected">Hard</option>
            </select>
            <svg class="select-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
    </form>
</section>

@* =========================================================================
   CATEGORY CHIPS — one chip per ExerciseCategory enum value.
   Each is a GET link that re-enters Index with ?category=<Value>,
   preserving the active search and difficulty filters.
   ========================================================================= *@
@{
    var categories = new[] { "Shoulder", "Elbow", "Wrist", "Spine", "Core", "Hip", "Knee", "Ankle" };
    bool allActive = string.IsNullOrEmpty(Model.CategoryFilter);
}
<div class="chip-row">
    <a asp-action="Index"
       asp-route-search="@Model.SearchQuery"
       asp-route-difficulty="@Model.DifficultyFilter"
       class="chip @(allActive ? "chip-active" : "")">
        All <span class="chip-count">@Model.TotalCount</span>
    </a>
    @foreach (var cat in categories)
    {
        bool isActive = string.Equals(Model.CategoryFilter, cat, StringComparison.OrdinalIgnoreCase);
        <a asp-action="Index"
           asp-route-search="@Model.SearchQuery"
           asp-route-difficulty="@Model.DifficultyFilter"
           asp-route-category="@cat"
           class="chip @(isActive ? "chip-active" : "")">
            @cat
        </a>
    }
</div>

@* =========================================================================
   GRID
   ========================================================================= *@
@if (Model.Exercises.Count == 0)
{
    <div class="empty-state card">
        <h3 class="empty-state-title">No exercises found</h3>
        <p class="empty-state-subtitle">Try adjusting your search or filter.</p>
    </div>
}
else
{
    <div class="exercise-grid">
        @foreach (var exercise in Model.Exercises)
        {
            string difficultyClass = exercise.Difficulty switch
            {
                "Easy" => "diff-beginner",
                "Moderate" => "diff-intermediate",
                "Hard" => "diff-advanced",
                _ => "diff-neutral"
            };

            <article class="exercise-card" onclick="openExerciseModal('@exercise.ExerciseId')" style="cursor:pointer;">
                @* Top visual — hatched background + region tag + icon disc *@
                <div class="exercise-visual">
                    <span class="region-tag">@exercise.Category.ToUpper()</span>

                    <div class="exercise-icon-disc">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004AAD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                        </svg>
                    </div>
                </div>

                @* Body — title + difficulty + description + meta *@
                <div class="exercise-body">
                    <div class="exercise-title-row">
                        <h3 class="exercise-name">@exercise.Name</h3>
                        <span class="difficulty-pill @difficultyClass">
                            <span class="difficulty-dot"></span>
                            @exercise.Difficulty?.ToUpper()
                        </span>
                    </div>

                    <p class="exercise-description">@exercise.Description</p>

                    <div class="exercise-meta">
                        <span class="meta-item">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            @exercise.DurationMinutes min
                        </span>
                        <span class="meta-item">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                            </svg>
                            @exercise.Sets×@exercise.Reps reps
                        </span>
                    </div>
                </div>

                @* Footer — assignment label + action icons (disabled until wired) *@
                <footer class="exercise-card-footer">
                    <span class="assigned-count">Available to assign</span>
                    <div class="card-actions">
                        <button type="button" class="icon-btn" disabled aria-label="Edit exercise">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                        </button>
                    </div>
                </footer>
            </article>
        }
    </div>
}

@* =========================================================================
   PAGINATION — uses the shared _Pagination partial so it matches every
   other listing page byte-for-byte.
   ========================================================================= *@
@await Html.PartialAsync("_Pagination", Model.Pagination)

@* =========================================================================
   EXERCISE DETAIL MODAL
   ========================================================================= *@
<div class="modal-overlay" id="exerciseDetailModal" aria-modal="true" role="dialog" aria-labelledby="exerciseModalTitle">
    <div class="modal modal-lg">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="exerciseModalTitle">Exercise Detail</h2>
            </div>
            <button type="button" class="modal-close" onclick="closeExerciseModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        @* Loading state *@
        <div id="exerciseModalLoading" class="modal-loading">Loading...</div>

        @* Content (hidden until loaded) *@
        <div id="exerciseModalContent" class="modal-body" style="display:none;">

            @* Video player *@
            <div id="exerciseVideoSection">
                <div class="video-frame">
                    <iframe id="exerciseVideoFrame"
                            src=""
                            title="Exercise demonstration"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            </div>

            @* No video placeholder *@
            <div id="exerciseNoVideo" class="video-empty" style="display:none;">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#C7C7CC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <p>No demonstration video for this exercise yet.</p>
            </div>

            @* Description *@
            <p id="exerciseModalDescription" class="modal-description"></p>

            @* Divider *@
            <div class="modal-divider"></div>

            @* Stats row *@
            <div class="profile-info-row">
                <div class="info-item">
                    <p class="info-label">Difficulty</p>
                    <p class="info-value" id="exerciseModalDifficulty"></p>
                </div>
                <div class="info-item">
                    <p class="info-label">Sets</p>
                    <p class="info-value" id="exerciseModalSets"></p>
                </div>
                <div class="info-item">
                    <p class="info-label">Reps</p>
                    <p class="info-value" id="exerciseModalReps"></p>
                </div>
                <div class="info-item">
                    <p class="info-label">Duration</p>
                    <p class="info-value" id="exerciseModalDuration"></p>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
(function () {
    var modal     = document.getElementById('exerciseDetailModal');
    var loading   = document.getElementById('exerciseModalLoading');
    var content   = document.getElementById('exerciseModalContent');
    var iframe    = document.getElementById('exerciseVideoFrame');
    var videoSec  = document.getElementById('exerciseVideoSection');
    var noVideo   = document.getElementById('exerciseNoVideo');

    async function openExerciseModal(id) {
        // Reset state
        loading.textContent    = 'Loading...';
        loading.style.display  = 'block';
        content.style.display  = 'none';
        iframe.src             = '';
        modal.classList.add('modal-visible');

        try {
            // Goes through the panel's own controller — same origin, HttpOnly auth cookie
            // is sent automatically; the panel forwards to the API server-side.
            var response = await fetch('/Exercises/GetJson/' + id, {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });

            if (!response.ok) {
                loading.textContent = 'Could not load exercise.';
                return;
            }

            var data = await response.json();

            // Title
            document.getElementById('exerciseModalTitle').textContent = data.name;

            // Video
            if (data.videoUrl) {
                videoSec.style.display = 'block';
                noVideo.style.display  = 'none';
                iframe.src             = 'https://www.youtube.com/embed/' + data.videoUrl;
            } else {
                videoSec.style.display = 'none';
                noVideo.style.display  = 'flex';
            }

            // Description + stats
            document.getElementById('exerciseModalDescription').textContent = data.description;
            document.getElementById('exerciseModalDifficulty').textContent  = data.difficulty;
            document.getElementById('exerciseModalSets').textContent        = data.sets;
            document.getElementById('exerciseModalReps').textContent        = data.reps;
            document.getElementById('exerciseModalDuration').textContent    = data.durationMinutes + ' min';

            loading.style.display = 'none';
            content.style.display = 'flex';

        } catch (err) {
            console.error('[exercise-modal]', err);
            loading.textContent = 'Could not load exercise.';
        }
    }

    function closeExerciseModal() {
        modal.classList.remove('modal-visible');
        iframe.src = ''; // stops YouTube audio
    }

    // Close on overlay click
    modal.addEventListener('click', function (e) {
        if (e.target === modal) closeExerciseModal();
    });

    // Expose for onclick
    window.openExerciseModal  = openExerciseModal;
    window.closeExerciseModal = closeExerciseModal;
})();
</script>
