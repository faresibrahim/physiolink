@model PhysioLink.AdminPanel.ViewModels.TherapistScheduleViewModel

@{
    ViewData["Title"] = "Therapist Schedule";
    ViewData["ActivePage"] = "Therapists";

    var dayNames = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    var prevWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
    var weekStartStr = Model.WeekStart.ToString("yyyy-MM-dd");
}

<a asp-action="Detail" asp-route-id="@Model.TherapistId" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    Back to @Model.TherapistName
</a>

<div class="card">
    <div class="profile-header" style="align-items:center;">
        <div>
            <h2 class="profile-name">@Model.TherapistName — Weekly Schedule</h2>
            <p class="profile-meta">
                Week of @Model.WeekStart.ToString("MMM d, yyyy") ·
                Operating hours @Model.OpenHour:00–@Model.CloseHour:00 (UTC)
            </p>
        </div>
        <div class="profile-actions">
            <a asp-action="Schedule" asp-route-id="@Model.TherapistId" asp-route-weekStart="@prevWeek" class="btn btn-ghost btn-sm">&larr; Prev week</a>
            <a asp-action="Schedule" asp-route-id="@Model.TherapistId" asp-route-weekStart="@nextWeek" class="btn btn-ghost btn-sm">Next week &rarr;</a>
        </div>
    </div>

    <p class="profile-meta" style="margin:8px 0 16px;">
        Click an empty cell to open a slot. Click an open (green) cell to remove it.
        Requested / booked cells are locked — decide or cancel them from the
        <a asp-action="Requests" asp-controller="Appointments">requests queue</a> first.
    </p>

    <div style="overflow-x:auto;">
        <table class="schedule-grid" style="width:100%; border-collapse:collapse; text-align:center;">
            <thead>
                <tr>
                    <th style="padding:8px; border-bottom:1px solid #e5e7eb; text-align:left;">Time</th>
                    @for (var d = 0; d < 7; d++)
                    {
                        <th style="padding:8px; border-bottom:1px solid #e5e7eb;">
                            <div style="font-weight:600;">@dayNames[d]</div>
                            <div class="profile-meta" style="font-size:12px;">@Model.DateForColumn(d).ToString("MMM d")</div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var hour in Model.Hours)
                {
                    <tr>
                        <td style="padding:8px; border-bottom:1px solid #f1f5f9; text-align:left; font-weight:500;">
                            @hour.ToString("00"):00
                        </td>
                        @for (var d = 0; d < 7; d++)
                        {
                            var cell = Model.CellAt(d, hour);
                            var scheduledAt = cell?.ScheduledAt ?? Model.WeekStart.AddDays(d).AddHours(hour);
                            var scheduledStr = scheduledAt.ToString("yyyy-MM-ddTHH:mm:ss");
                            var state = cell?.State ?? "Empty";
                            <td style="padding:4px; border-bottom:1px solid #f1f5f9;">
                                @if (state == "Empty")
                                {
                                    <form asp-action="AddSlot" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="therapistId" value="@Model.TherapistId" />
                                        <input type="hidden" name="scheduledAt" value="@scheduledStr" />
                                        <input type="hidden" name="weekStart" value="@weekStartStr" />
                                        <button type="submit" class="slot-cell slot-empty" title="Open this slot"
                                                style="width:100%; padding:8px; border:1px dashed #cbd5e1; background:transparent; color:#94a3b8; border-radius:8px; cursor:pointer;">
                                            +
                                        </button>
                                    </form>
                                }
                                else if (state == "Available")
                                {
                                    <form asp-action="RemoveSlot" method="post" style="margin:0;"
                                          onsubmit="return confirm('Remove this open slot?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="therapistId" value="@Model.TherapistId" />
                                        <input type="hidden" name="scheduledAt" value="@scheduledStr" />
                                        <input type="hidden" name="weekStart" value="@weekStartStr" />
                                        <button type="submit" class="slot-cell slot-available" title="Open — click to remove"
                                                style="width:100%; padding:8px; border:1px solid #34C759; background:#ecfdf3; color:#15803d; border-radius:8px; cursor:pointer; font-weight:600;">
                                            Open
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    var locked = state == "Booked";
                                    var bg = locked ? "#eff6ff" : "#fff7ed";
                                    var fg = locked ? "#1d4ed8" : "#c2410c";
                                    var bd = locked ? "#3b82f6" : "#f97316";
                                    <div class="slot-cell slot-locked" title="Locked — @state"
                                         style="width:100%; padding:8px; border:1px solid @bd; background:@bg; color:@fg; border-radius:8px; font-weight:600;">
                                        @state 🔒
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
