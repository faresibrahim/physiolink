@model PhysioLink.AdminPanel.ViewModels.TherapistFormViewModel
@{
    var formAction = Model.IsEdit ? "Edit" : "Create";
}

<div class="card form-card">

    <h2 class="card-title">@(Model.IsEdit ? L["Edit Therapist"] : L["Add therapist"])</h2>
    <p class="card-subtitle">@(Model.IsEdit ? L["Update this practitioner's details."] : L["Add a new practitioner to your clinic."])</p>
    <div class="profile-divider"></div>

    <form asp-action="@formAction" asp-route-id="@Model.TherapistId" method="post" class="form-stack">
        @Html.AntiForgeryToken()

        @if (Model.IsEdit)
        {
            <input type="hidden" asp-for="TherapistId" />
        }

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="FirstName">@L["First name"]</label>
                <input asp-for="FirstName" class="form-input" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="LastName">@L["Last name"]</label>
                <input asp-for="LastName" class="form-input" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Specialty">@L["Specialty"]</label>
            <input asp-for="Specialty" class="form-input" />
            <span asp-validation-for="Specialty" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="PhoneNumber">@L["Phone"]</label>
            <input asp-for="PhoneNumber" class="form-input" />
            <span asp-validation-for="PhoneNumber" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Email">@L["Email"]</label>
            <input asp-for="Email" class="form-input" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                @(Model.IsEdit ? L["Save Changes"] : L["Add therapist"])
            </button>
            <a asp-action="Index" class="btn btn-ghost">
                @L["Cancel"]
            </a>
        </div>

    </form>
</div>
