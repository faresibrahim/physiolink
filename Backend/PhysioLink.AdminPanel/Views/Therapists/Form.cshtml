@model PhysioLink.AdminPanel.ViewModels.TherapistFormViewModel
@{
    var formAction = Model.IsEdit ? "Edit" : "Create";
}

<div class="card form-card">

    <h2 class="card-title">@(Model.IsEdit ? "Edit Therapist" : "Add Therapist")</h2>
    <p class="card-subtitle">@(Model.IsEdit ? "Update this practitioner's details." : "Add a new practitioner to your clinic.")</p>
    <div class="profile-divider"></div>

    <form asp-action="@formAction" asp-route-id="@Model.TherapistId" method="post" class="form-stack">
        @Html.AntiForgeryToken()

        @if (Model.IsEdit)
        {
            <input type="hidden" asp-for="TherapistId" />
        }

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="FirstName">First Name</label>
                <input asp-for="FirstName" class="form-input" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="LastName">Last Name</label>
                <input asp-for="LastName" class="form-input" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Specialty">Specialty</label>
            <input asp-for="Specialty" class="form-input" />
            <span asp-validation-for="Specialty" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="PhoneNumber">Phone</label>
            <input asp-for="PhoneNumber" class="form-input" />
            <span asp-validation-for="PhoneNumber" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Email">Email</label>
            <input asp-for="Email" class="form-input" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                @(Model.IsEdit ? "Save Changes" : "Add Therapist")
            </button>
            <a asp-action="Index" class="btn btn-ghost">
                Cancel
            </a>
        </div>

    </form>
</div>
