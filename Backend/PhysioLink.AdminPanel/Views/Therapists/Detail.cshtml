@model PhysioLink.AdminPanel.ViewModels.TherapistDetailViewModel

@{
    ViewData["Title"] = "Therapist Detail";
    ViewData["ActivePage"] = "Therapists";
}

<a asp-action="Index" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    @L["Back to Therapists"]
</a>

<div class="detail-main">

    <div class="card">

        <div class="profile-header">

            <div class="profile-id">

                <div>
                    <h2 class="profile-name">
                        @Model.Therapist.FirstName @Model.Therapist.LastName
                    </h2>

                    <p class="profile-meta">
                        @Model.Therapist.Specialty
                    </p>

                    @await Html.PartialAsync("_StatusBadge", Model.Therapist.IsActive ? "Active" : "Inactive")
                </div>

            </div>

            <div class="profile-actions">

                <a asp-action="Schedule"
                   asp-route-id="@Model.Therapist.Id"
                   class="btn btn-ghost btn-sm">
                    @L["Manage schedule"]
                </a>

                <button type="button" class="btn btn-ghost btn-sm edit-therapist-btn"
                        data-id="@Model.Therapist.Id"
                        data-first-name="@Model.Therapist.FirstName"
                        data-last-name="@Model.Therapist.LastName"
                        data-specialty="@Model.Therapist.Specialty"
                        data-phone-number="@Model.Therapist.PhoneNumber"
                        data-email="@Model.Therapist.Email">
                    @L["Edit"]
                </button>

                <form asp-action="Deactivate"
                      asp-route-id="@Model.Therapist.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger-outline btn-sm">
                        @L["Deactivate"]
                    </button>

                </form>

            </div>

        </div>

        <div class="profile-divider"></div>

        <div class="profile-info-row">
            <div class="info-item">
                <p class="info-label">@L["Phone"]</p>
                <p class="info-value">@Model.Therapist.PhoneNumber</p>
            </div>
            <div class="info-item">
                <p class="info-label">@L["Email"]</p>
                <p class="info-value">@Model.Therapist.Email</p>
            </div>
        </div>

    </div>

    @* Assigned patients — the shared data-table card (datatable-export design).
       Every assigned patient is listed, so there is no pagination footer. *@
    <div class="dt-card">

        <div class="dt-header">
            <div>
                <h3 class="dt-title">@L["Assigned Patients"]</h3>
                <p class="dt-subtitle">@L[Model.AssignedPatients.Count == 1 ? "{0} patient under this therapist's care" : "{0} patients under this therapist's care", Model.AssignedPatients.Count]</p>
            </div>

            <button type="button" onclick="openPatientModal()" class="dt-btn dt-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                @L["Add Patient"]
            </button>
        </div>

        <div class="dt-scroll">
            <table class="dt-table">
                <thead>
                    <tr>
                        <th>@L["Patient"]</th>
                        <th>@L["Phone"]</th>
                        <th>@L["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AssignedPatients.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="empty-row">
                                @L["No patients assigned to this therapist yet."]
                            </td>
                        </tr>
                    }

                    @foreach (var patient in Model.AssignedPatients)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Patients" asp-action="Detail"
                                   asp-route-id="@patient.PatientId"
                                   class="dt-name">@patient.FirstName @patient.LastName</a>
                            </td>
                            <td><span dir="ltr">@patient.PhoneNumber</span></td>
                            <td>
                                @await Html.PartialAsync("_DataTableBadge", patient.IsActive ? "Active" : "Inactive")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

@* ── Shared "New Patient" dialog — preselects this therapist ────────────────── *@
@await Html.PartialAsync("_CreatePatientModal", new PhysioLink.AdminPanel.ViewModels.CreatePatientModalViewModel
{
    Therapists = Model.Therapists,
    PreselectedTherapistId = Model.Therapist.Id
})

@* Edit Therapist dialog — shared with the Therapists list *@
@await Html.PartialAsync("_EditTherapistModal", "Detail")
