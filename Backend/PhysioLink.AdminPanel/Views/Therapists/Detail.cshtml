@model PhysioLink.AdminPanel.ViewModels.TherapistDetailViewModel

@{
    ViewData["Title"] = "Therapist Detail";
    ViewData["ActivePage"] = "Therapists";
}

<a asp-action="Index" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    @L["Back to Therapists"]
</a>

<div class="detail-main">

    <div class="card">

        <div class="profile-header">

            <div class="profile-id">

                <div>
                    <h2 class="profile-name">
                        @Model.Therapist.FirstName @Model.Therapist.LastName
                    </h2>

                    <p class="profile-meta">
                        @Model.Therapist.Specialty
                    </p>

                    @await Html.PartialAsync("_StatusBadge", Model.Therapist.IsActive ? "Active" : "Inactive")
                </div>

            </div>

            <div class="profile-actions">

                <a asp-action="Schedule"
                   asp-route-id="@Model.Therapist.Id"
                   class="btn btn-ghost btn-sm">
                    @L["Manage schedule"]
                </a>

                <button type="button" class="btn btn-ghost btn-sm edit-therapist-btn"
                        data-id="@Model.Therapist.Id"
                        data-first-name="@Model.Therapist.FirstName"
                        data-last-name="@Model.Therapist.LastName"
                        data-specialty="@Model.Therapist.Specialty"
                        data-phone-number="@Model.Therapist.PhoneNumber"
                        data-email="@Model.Therapist.Email">
                    @L["Edit"]
                </button>

                <button type="button" class="btn btn-danger-outline btn-sm" onclick="openDeactivateTherapistModal()">
                    @L["Deactivate"]
                </button>

            </div>

        </div>

        <div class="profile-divider"></div>

        <div class="profile-info-row">
            <div class="info-item">
                <p class="info-label">@L["Phone"]</p>
                <p class="info-value">@Model.Therapist.PhoneNumber</p>
            </div>
            <div class="info-item">
                <p class="info-label">@L["Email"]</p>
                <p class="info-value">@Model.Therapist.Email</p>
            </div>
        </div>

    </div>

    @* Assigned patients — the shared data-table card (datatable-export design).
       Every assigned patient is listed, so there is no pagination footer. *@
    <div class="dt-card">

        <div class="dt-header">
            <div>
                <h3 class="dt-title">@L["Assigned Patients"]</h3>
                <p class="dt-subtitle">@L[Model.AssignedPatients.Count == 1 ? "{0} patient under this therapist's care" : "{0} patients under this therapist's care", Model.AssignedPatients.Count]</p>
            </div>

            <button type="button" onclick="openPatientModal()" class="dt-btn dt-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                @L["Add Patient"]
            </button>
        </div>

        <div class="dt-scroll">
            <table class="dt-table">
                <thead>
                    <tr>
                        <th>@L["Patient"]</th>
                        <th>@L["Phone"]</th>
                        <th>@L["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AssignedPatients.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="empty-row">
                                @L["No patients assigned to this therapist yet."]
                            </td>
                        </tr>
                    }

                    @foreach (var patient in Model.AssignedPatients)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Patients" asp-action="Detail"
                                   asp-route-id="@patient.PatientId"
                                   class="dt-name">@patient.FirstName @patient.LastName</a>
                            </td>
                            <td><span dir="ltr">@patient.PhoneNumber</span></td>
                            <td>
                                @await Html.PartialAsync("_DataTableBadge", patient.IsActive ? "Active" : "Inactive")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

@* ── Shared "New Patient" dialog — preselects this therapist ────────────────── *@
@await Html.PartialAsync("_CreatePatientModal", new PhysioLink.AdminPanel.ViewModels.CreatePatientModalViewModel
{
    Therapists = Model.Therapists,
    PreselectedTherapistId = Model.Therapist.Id
})

@* Edit Therapist dialog — shared with the Therapists list *@
@await Html.PartialAsync("_EditTherapistModal", "Detail")

@* =========================================================================
   DEACTIVATE THERAPIST MODAL — re-authentication gate on a destructive action.
   The admin must retype their own account password; the controller verifies
   it against the API before the therapist is deactivated (same as patients).
   ========================================================================= *@
<div class="modal-overlay" id="deactivateTherapistModal" aria-modal="true" role="dialog" aria-labelledby="deactivateTherapistModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="deactivateTherapistModalTitle">@L["Deactivate Therapist"]</h2>
                <p class="modal-subtitle">@Model.Therapist.FirstName @Model.Therapist.LastName</p>
            </div>
            <button type="button" class="modal-close" onclick="closeDeactivateTherapistModal()" aria-label="@L["Close"]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Deactivate" asp-controller="Therapists" asp-route-id="@Model.Therapist.Id" class="modal-form" id="deactivateTherapistForm">
            @Html.AntiForgeryToken()

            <div class="alert alert-danger" role="alert">
                @L["{0} will immediately lose access to PhysioLink. Records and history are retained.", Model.Therapist.FirstName]
            </div>

            <div class="form-group">
                <label class="form-label" for="deactivateTherapistPassword">@L["Your account password"]</label>
                <input type="password" id="deactivateTherapistPassword" name="password" class="form-input" autocomplete="current-password" />
                <span class="form-hint">@L["Confirm it's you — enter the password you sign in with."]</span>
                <span class="field-error" id="deactivateTherapistPasswordError" style="display:none;">@L["Enter your password to continue."]</span>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeDeactivateTherapistModal()">@L["Cancel"]</button>
                <button type="submit" class="btn btn-danger">@L["Deactivate Account"]</button>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var modal         = document.getElementById('deactivateTherapistModal');
        var form          = document.getElementById('deactivateTherapistForm');
        var passwordInput = document.getElementById('deactivateTherapistPassword');
        var passwordError = document.getElementById('deactivateTherapistPasswordError');
        if (!modal || !form) return;

        function openDeactivateTherapistModal() {
            modal.classList.add('modal-visible');
            window.plModal.opened(modal);
            passwordInput.focus();
        }

        function closeDeactivateTherapistModal() {
            modal.classList.remove('modal-visible');
            window.plModal.closed(modal);
            // Never leave the password sitting in the DOM after the dialog closes
            passwordInput.value = '';
            passwordError.style.display = 'none';
        }

        // Deliberately no overlay-click-to-close: closing should be an explicit
        // choice, not a stray click on this confirmation dialog.

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal.classList.contains('modal-visible')) {
                closeDeactivateTherapistModal();
            }
        });

        form.addEventListener('submit', function (e) {
            if (!passwordInput.value) {
                e.preventDefault();
                passwordError.style.display = 'block';
                passwordInput.focus();
            }
        });

        passwordInput.addEventListener('input', function () {
            passwordError.style.display = 'none';
        });

        window.openDeactivateTherapistModal  = openDeactivateTherapistModal;
        window.closeDeactivateTherapistModal = closeDeactivateTherapistModal;
    })();
</script>
