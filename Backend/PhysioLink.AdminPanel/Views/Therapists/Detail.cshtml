@model PhysioLink.AdminPanel.ViewModels.TherapistDetailViewModel

@{
    ViewData["Title"] = "Therapist Detail";
    ViewData["ActivePage"] = "Therapists";
}

<a asp-action="Index" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    Back to Therapists
</a>

<div class="detail-main">

    <div class="card">

        <div class="profile-header">

            <div class="profile-id">

                <div class="avatar avatar-lg">
                    @Model.Therapist.FirstName[0]@Model.Therapist.LastName[0]
                </div>

                <div>
                    <h2 class="profile-name">
                        @Model.Therapist.FirstName @Model.Therapist.LastName
                    </h2>

                    <p class="profile-meta">
                        @Model.Therapist.Specialty
                    </p>

                    @await Html.PartialAsync("_StatusBadge", Model.Therapist.IsActive ? "Active" : "Inactive")
                </div>

            </div>

            <div class="profile-actions">

                <a asp-action="Schedule"
                   asp-route-id="@Model.Therapist.Id"
                   class="btn btn-ghost btn-sm">
                    Manage schedule
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Therapist.Id"
                   class="btn btn-ghost btn-sm">
                    Edit
                </a>

                <form asp-action="Deactivate"
                      asp-route-id="@Model.Therapist.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger-outline btn-sm">
                        Deactivate
                    </button>

                </form>

            </div>

        </div>

        <div class="profile-divider"></div>

        <div class="profile-info-row">
            <div class="info-item">
                <p class="info-label">Phone</p>
                <p class="info-value">@Model.Therapist.PhoneNumber</p>
            </div>
            <div class="info-item">
                <p class="info-label">Email</p>
                <p class="info-value">@Model.Therapist.Email</p>
            </div>
        </div>

    </div>

    <div class="card">

        <div class="card-header-row">
            <div>
                <h3 class="card-title">Assigned Patients</h3>
                <p class="card-subtitle">@Model.AssignedPatients.Count patient@(Model.AssignedPatients.Count == 1 ? "" : "s") under this therapist's care</p>
            </div>

            <button type="button" onclick="openPatientModal()" class="btn btn-primary btn-sm">
                + Add Patient
            </button>
        </div>

        <table class="data-table">

            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.AssignedPatients.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-row">
                            No patients assigned to this therapist yet.
                        </td>
                    </tr>
                }

                @foreach (var patient in Model.AssignedPatients)
                {
                    <tr>

                        <td>
                            <div class="cell-person">
                                <div class="avatar avatar-sm">
                                    @patient.FirstName[0]@patient.LastName[0]
                                </div>
                                <span class="name">
                                    @patient.FirstName @patient.LastName
                                </span>
                            </div>
                        </td>

                        <td class="muted-cell">
                            @patient.PhoneNumber
                        </td>

                        <td>
                            @await Html.PartialAsync("_StatusBadge", patient.IsActive ? "Active" : "Inactive")
                        </td>

                        <td>
                            <a asp-controller="Patients"
                               asp-action="Detail"
                               asp-route-id="@patient.PatientId"
                               class="btn btn-ghost btn-sm">
                                View
                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@* ── Shared "New Patient" dialog — preselects this therapist ────────────────── *@
@await Html.PartialAsync("_CreatePatientModal", new PhysioLink.AdminPanel.ViewModels.CreatePatientModalViewModel
{
    Therapists = Model.Therapists,
    PreselectedTherapistId = Model.Therapist.Id
})
