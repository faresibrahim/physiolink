@model PhysioLink.AdminPanel.ViewModels.TherapistDetailViewModel

@{
    ViewData["Title"] = "Therapist Detail";
    ViewData["ActivePage"] = "Therapists";
}

<div style="margin-bottom:1.5rem;">
    <a asp-action="Index" style="color:#8E8E93; text-decoration:none; font-size:14px;">
        ← Back to Therapists
    </a>
</div>

<div style="background:white; border-radius:14px; border:0.5px solid #e5e5ea; padding:24px; margin-bottom:20px;">

    <div style="display:flex; justify-content:space-between; align-items:flex-start;">

        <div style="display:flex; align-items:center; gap:16px;">

            <div style="width:56px; height:56px; border-radius:50%; background:#e8f0fb; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:18px; color:#004AAD;">
                @Model.Therapist.FirstName[0]@Model.Therapist.LastName[0]
            </div>

            <div>

                <h2 style="font-size:1.2rem; font-weight:600; color:#323232; margin:0;">
                    @Model.Therapist.FirstName @Model.Therapist.LastName
                </h2>

                <p style="color:#8E8E93; font-size:14px; margin:4px 0;">
                    @Model.Therapist.Specialty
                </p>

                @await Html.PartialAsync("_StatusBadge", Model.Therapist.IsActive ? "Active" : "Inactive")

            </div>

        </div>

        <div style="display:flex; gap:8px;">

            <a asp-action="Edit"
               asp-route-id="@Model.Therapist.Id"
               style="padding:9px 18px; border:0.5px solid #e5e5ea; color:#323232; border-radius:8px; text-decoration:none; font-size:13px; font-weight:500;">
                Edit
            </a>

            <form asp-action="Deactivate"
                  asp-route-id="@Model.Therapist.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        style="padding:9px 18px; border:0.5px solid #FF3B30; color:#FF3B30; border-radius:8px; background:transparent; font-size:13px; font-weight:500; cursor:pointer;">
                    Deactivate
                </button>

            </form>

        </div>

    </div>

    <div style="border-top:0.5px solid #f2f2f7; margin-top:20px; padding-top:20px; display:flex; gap:32px;">

        <div>
            <p style="font-size:12px; color:#8E8E93; margin:0 0 4px;">Phone</p>

            <p style="font-size:14px; color:#323232; font-weight:500; margin:0;">
                @Model.Therapist.PhoneNumber
            </p>
        </div>

        <div>
            <p style="font-size:12px; color:#8E8E93; margin:0 0 4px;">Email</p>

            <p style="font-size:14px; color:#323232; font-weight:500; margin:0;">
                @Model.Therapist.Email
            </p>
        </div>

    </div>

</div>

<div style="background:white; border-radius:14px; border:0.5px solid #e5e5ea; padding:24px;">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">

        <h3 style="font-size:1rem; font-weight:600; color:#323232; margin:0;">
            Assigned Patients

            <span style="font-size:13px; color:#8E8E93; font-weight:400; margin-left:8px;">
                @Model.AssignedPatients.Count patients
            </span>
        </h3>

        <a asp-controller="Patients"
           asp-action="Create"
           style="background:#004AAD; color:white; padding:8px 16px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:500;">
            + Add Patient
        </a>

    </div>

    <table style="width:100%; border-collapse:collapse; font-size:14px;">

        <thead>
            <tr style="border-bottom:0.5px solid #f2f2f7;">
                <th style="text-align:left; padding:10px 12px; color:#8E8E93; font-weight:500; font-size:12px;">Patient</th>
                <th style="text-align:left; padding:10px 12px; color:#8E8E93; font-weight:500; font-size:12px;">Phone</th>
                <th style="text-align:left; padding:10px 12px; color:#8E8E93; font-weight:500; font-size:12px;">Status</th>
                <th style="text-align:left; padding:10px 12px; color:#8E8E93; font-weight:500; font-size:12px;">Actions</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.AssignedPatients.Count == 0)
            {
                <tr>
                    <td colspan="4"
                        style="text-align:center; padding:40px; color:#8E8E93; font-size:14px;">
                        No patients assigned to this therapist yet.
                    </td>
                </tr>
            }

            @foreach (var patient in Model.AssignedPatients)
            {
                <tr style="border-bottom:0.5px solid #f2f2f7;">

                    <td style="padding:12px;">

                        <div style="display:flex; align-items:center; gap:10px;">

                            <div style="width:34px; height:34px; border-radius:50%; background:#e8f0fb; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:12px; color:#004AAD;">
                                @patient.FirstName[0]@patient.LastName[0]
                            </div>

                            <span style="font-weight:500; color:#323232;">
                                @patient.FirstName @patient.LastName
                            </span>

                        </div>

                    </td>

                    <td style="padding:12px; color:#8E8E93;">
                        @patient.PhoneNumber
                    </td>

                    <td style="padding:12px;">

                        @await Html.PartialAsync("_StatusBadge", patient.IsActive ? "Active" : "Inactive")

                    </td>

                    <td style="padding:12px;">

                        <a asp-controller="Patients"
                           asp-action="Detail"
                           asp-route-id="@patient.PatientId"
                           style="color:#004AAD; text-decoration:none; font-size:13px; font-weight:500;">
                            View →
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>