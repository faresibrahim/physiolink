@model PhysioLink.AdminPanel.ViewModels.TherapistListViewModel

@{
    ViewData["Title"] = "Therapists";
    ViewData["ActivePage"] = "Therapists";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Therapists</h1>
        <p class="page-sub">
            @Model.TotalCount active practitioners.
        </p>
    </div>

    <button type="button" onclick="openTherapistModal()" class="btn btn-primary">
        + Add Therapist
    </button>
</div>

<div class="therapist-grid">

    @if (Model.Therapists.Count == 0)
    {
        <div class="card empty-state grid-span-all">
            <h3 class="empty-state-title">No therapists yet</h3>
            <p class="empty-state-subtitle">Add your first practitioner to get started.</p>
        </div>
    }

    @foreach (var therapist in Model.Therapists)
    {
        <div class="card therapist-card">

            <div class="therapist-card-top">

                <div class="therapist-identity">
                    <div class="avatar">
                        @therapist.FirstName[0]@therapist.LastName[0]
                    </div>
                    <div>
                        <p class="therapist-name">
                            @therapist.FirstName @therapist.LastName
                        </p>
                        <p class="therapist-specialty">
                            @therapist.Specialty
                        </p>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusBadge", therapist.IsActive ? "Active" : "Inactive")

            </div>

            <div class="therapist-contact">
                <span class="contact-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span>@therapist.PhoneNumber</span>
                </span>
                <span class="contact-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    <span>@therapist.Email</span>
                </span>
            </div>

            <div class="therapist-card-actions">

                <a asp-action="Detail"
                   asp-route-id="@therapist.Id"
                   class="btn btn-secondary btn-sm">
                    View
                </a>

                <button type="button" class="btn btn-ghost btn-sm edit-therapist-btn"
                        data-id="@therapist.Id"
                        data-first-name="@therapist.FirstName"
                        data-last-name="@therapist.LastName"
                        data-specialty="@therapist.Specialty"
                        data-phone-number="@therapist.PhoneNumber"
                        data-email="@therapist.Email">
                    Edit
                </button>

                <form asp-action="Deactivate"
                      asp-route-id="@therapist.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger-outline btn-sm btn-block">
                        Deactivate
                    </button>

                </form>

            </div>

        </div>
    }

</div>

@await Html.PartialAsync("_Pagination", Model.Pagination)

@* ── Add Therapist Modal ──────────────────────────────────────────────── *@
<div class="modal-overlay" id="therapistModal" aria-modal="true" role="dialog" aria-labelledby="therapistModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="therapistModalTitle">Add Therapist</h2>
                <p class="modal-subtitle">Add a new practitioner to your clinic.</p>
            </div>
            <button type="button" class="modal-close" onclick="closeTherapistModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Create" asp-controller="Therapists" class="modal-form" id="therapistForm">
            @Html.AntiForgeryToken()

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="ther-FirstName">First Name</label>
                    <input type="text" id="ther-FirstName" name="FirstName" class="form-input" placeholder="e.g. Sarah" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="ther-LastName">Last Name</label>
                    <input type="text" id="ther-LastName" name="LastName" class="form-input" placeholder="e.g. Connor" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="ther-Specialty">Specialty</label>
                <input type="text" id="ther-Specialty" name="Specialty" class="form-input" placeholder="e.g. Sports Rehabilitation" />
            </div>

            <div class="form-group">
                <label class="form-label" for="ther-PhoneNumber">Phone</label>
                <input type="text" id="ther-PhoneNumber" name="PhoneNumber" class="form-input" placeholder="+970 5XX XXX XXX" />
            </div>

            <div class="form-group">
                <label class="form-label" for="ther-Email">Email</label>
                <input type="email" id="ther-Email" name="Email" class="form-input" placeholder="therapist@example.com" />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeTherapistModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Add Therapist</button>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var therapistModal = document.getElementById('therapistModal');
        var therapistForm  = document.getElementById('therapistForm');
        if (!therapistModal || !therapistForm) return;

        function openTherapistModal() {
            therapistModal.classList.add('modal-visible');
        }

        function closeTherapistModal() {
            therapistModal.classList.remove('modal-visible');
            therapistForm.reset();
        }

        // Deliberately no overlay-click-to-close: an admin mid-form shouldn't lose
        // their entered data from a stray click. Close only via the X or Cancel.

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && therapistModal.classList.contains('modal-visible')) {
                closeTherapistModal();
            }
        });

        // Client-side validation
        therapistForm.addEventListener('submit', function (e) {
            var first     = document.getElementById('ther-FirstName').value.trim();
            var last      = document.getElementById('ther-LastName').value.trim();
            var specialty = document.getElementById('ther-Specialty').value.trim();
            var phone     = document.getElementById('ther-PhoneNumber').value.trim();
            var email     = document.getElementById('ther-Email').value.trim();

            if (!first || !last || !specialty || !phone || !email) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });

        window.openTherapistModal  = openTherapistModal;
        window.closeTherapistModal = closeTherapistModal;
    })();
</script>

@* ── Edit Therapist Modal ─────────────────────────────────────────────── *@
<div class="modal-overlay" id="editTherapistModal" aria-modal="true" role="dialog" aria-labelledby="editTherapistModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="editTherapistModalTitle">Edit Therapist</h2>
                <p class="modal-subtitle">Update this practitioner's details.</p>
            </div>
            <button type="button" class="modal-close" onclick="closeEditTherapistModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Edit" asp-controller="Therapists" class="modal-form" id="editTherapistForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="edit-ther-Id" name="id" value="" />
            <input type="hidden" name="TherapistId" value="" id="edit-ther-TherapistId" />

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="edit-ther-FirstName">First Name</label>
                    <input type="text" id="edit-ther-FirstName" name="FirstName" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-ther-LastName">Last Name</label>
                    <input type="text" id="edit-ther-LastName" name="LastName" class="form-input" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-ther-Specialty">Specialty</label>
                <input type="text" id="edit-ther-Specialty" name="Specialty" class="form-input" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-ther-PhoneNumber">Phone</label>
                <input type="text" id="edit-ther-PhoneNumber" name="PhoneNumber" class="form-input" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-ther-Email">Email</label>
                <input type="email" id="edit-ther-Email" name="Email" class="form-input" />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeEditTherapistModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var editTherapistModal = document.getElementById('editTherapistModal');
        var editTherapistForm  = document.getElementById('editTherapistForm');
        if (!editTherapistModal || !editTherapistForm) return;

        function openEditTherapistModal(id, firstName, lastName, specialty, phoneNumber, email) {
            document.getElementById('edit-ther-Id').value          = id;
            document.getElementById('edit-ther-TherapistId').value = id;
            document.getElementById('edit-ther-FirstName').value   = firstName || '';
            document.getElementById('edit-ther-LastName').value    = lastName || '';
            document.getElementById('edit-ther-Specialty').value   = specialty || '';
            document.getElementById('edit-ther-PhoneNumber').value = phoneNumber || '';
            document.getElementById('edit-ther-Email').value       = email || '';

            editTherapistModal.classList.add('modal-visible');
        }

        function closeEditTherapistModal() {
            editTherapistModal.classList.remove('modal-visible');
        }

        // Event delegation: one listener covers every "Edit" button in the grid,
        // reading the therapist's data straight from its data-* attributes.
        document.querySelectorAll('.edit-therapist-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openEditTherapistModal(
                    btn.dataset.id,
                    btn.dataset.firstName,
                    btn.dataset.lastName,
                    btn.dataset.specialty,
                    btn.dataset.phoneNumber,
                    btn.dataset.email
                );
            });
        });

        // Deliberately no overlay-click-to-close: an admin mid-form shouldn't lose
        // their entered data from a stray click. Close only via the X or Cancel.

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && editTherapistModal.classList.contains('modal-visible')) {
                closeEditTherapistModal();
            }
        });

        // Client-side validation
        editTherapistForm.addEventListener('submit', function (e) {
            var first     = document.getElementById('edit-ther-FirstName').value.trim();
            var last      = document.getElementById('edit-ther-LastName').value.trim();
            var specialty = document.getElementById('edit-ther-Specialty').value.trim();
            var phone     = document.getElementById('edit-ther-PhoneNumber').value.trim();
            var email     = document.getElementById('edit-ther-Email').value.trim();

            if (!first || !last || !specialty || !phone || !email) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });

        window.closeEditTherapistModal = closeEditTherapistModal;
    })();
</script>
