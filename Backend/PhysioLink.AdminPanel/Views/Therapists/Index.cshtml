@model PhysioLink.AdminPanel.ViewModels.TherapistListViewModel

@{
    ViewData["Title"] = "Therapists";
    ViewData["ActivePage"] = "Therapists";
}

@* Same data-table card as the Patients page (title and controls in the header,
   entry count + pagination in the footer) — the body is a grid of therapist
   cards instead of table rows. *@
<div class="dt-card">

<div class="dt-header">
    <div>
        <h1 class="dt-title">@L["Therapists"]</h1>
        <p class="dt-subtitle">
            @L[Model.TotalCount == 1 ? "{0} active practitioner" : "{0} active practitioners", Model.TotalCount]
        </p>
    </div>

    <div class="dt-tools">
        <button type="button" onclick="openTherapistModal()" class="dt-btn dt-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
            @L["Add therapist"]
        </button>
    </div>
</div>

<div class="therapist-grid dt-cards">

    @if (Model.Therapists.Count == 0)
    {
        <div class="empty-state grid-span-all">
            <h2 class="empty-state-title">@L["No therapists yet"]</h2>
            <p class="empty-state-subtitle">@L["Add your first practitioner to get started."]</p>
            <div class="empty-state-action">
                <button type="button" onclick="openTherapistModal()" class="btn btn-primary btn-sm">@L["Add therapist"]</button>
            </div>
        </div>
    }

    @foreach (var therapist in Model.Therapists)
    {
        <div class="card therapist-card">

            <div class="therapist-card-top">

                <div class="therapist-identity">
                    <div>
                        <p class="therapist-name">
                            @therapist.FirstName @therapist.LastName
                        </p>
                        <p class="therapist-specialty">
                            @therapist.Specialty
                        </p>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusBadge", therapist.IsActive ? "Active" : "Inactive")

            </div>

            <div class="therapist-contact">
                <span class="contact-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span>@therapist.PhoneNumber</span>
                </span>
                <span class="contact-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    <span>@therapist.Email</span>
                </span>
            </div>

            <div class="therapist-card-actions">

                <a asp-action="Detail"
                   asp-route-id="@therapist.Id"
                   class="btn btn-secondary btn-sm">
                    @L["View"]
                </a>

                <button type="button" class="btn btn-ghost btn-sm edit-therapist-btn"
                        data-id="@therapist.Id"
                        data-first-name="@therapist.FirstName"
                        data-last-name="@therapist.LastName"
                        data-specialty="@therapist.Specialty"
                        data-phone-number="@therapist.PhoneNumber"
                        data-email="@therapist.Email">
                    @L["Edit"]
                </button>

            </div>

        </div>
    }

</div>

@await Html.PartialAsync("_DataTableFooter", new PhysioLink.AdminPanel.ViewModels.Shared.DataTableFooterViewModel
{
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    ItemCount = Model.Therapists.Count,
    Pagination = Model.Pagination
})

</div>

@* ── Add Therapist Modal ──────────────────────────────────────────────── *@
<div class="modal-overlay" id="therapistModal" aria-modal="true" role="dialog" aria-labelledby="therapistModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="therapistModalTitle">@L["Add therapist"]</h2>
                <p class="modal-subtitle">@L["Add a new practitioner to your clinic."]</p>
            </div>
            <button type="button" class="modal-close" onclick="closeTherapistModal()" aria-label="@L["Close"]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Create" asp-controller="Therapists" class="modal-form" id="therapistForm" novalidate>
            @Html.AntiForgeryToken()
            <div class="alert alert-danger form-error-banner" role="alert" hidden></div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="ther-FirstName">@L["First name"]</label>
                    <input type="text" id="ther-FirstName" name="FirstName" class="form-input" placeholder="@L["e.g. Sarah"]" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="ther-LastName">@L["Last name"]</label>
                    <input type="text" id="ther-LastName" name="LastName" class="form-input" placeholder="@L["e.g. Connor"]" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="ther-Specialty">@L["Specialty"]</label>
                <input type="text" id="ther-Specialty" name="Specialty" class="form-input" placeholder="@L["e.g. Sports Rehabilitation"]" />
            </div>

            <div class="form-group">
                <label class="form-label" for="ther-PhoneNumber">@L["Phone"]</label>
                <input type="text" id="ther-PhoneNumber" name="PhoneNumber" class="form-input" placeholder="+970 5XX XXX XXX" />
            </div>

            <div class="form-group">
                <label class="form-label" for="ther-Email">@L["Email"]</label>
                <input type="email" id="ther-Email" name="Email" class="form-input" placeholder="therapist@example.com" />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeTherapistModal()">@L["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L["Add therapist"]</button>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var therapistModal = document.getElementById('therapistModal');
        var therapistForm  = document.getElementById('therapistForm');
        if (!therapistModal || !therapistForm) return;

        function openTherapistModal() {
            window.plForm.clearErrors(therapistModal);
            therapistModal.classList.add('modal-visible');
            window.plModal.opened(therapistModal);
        }

        function closeTherapistModal() {
            therapistModal.classList.remove('modal-visible');
            therapistForm.reset();
            window.plModal.closed(therapistModal);
        }

        // Deliberately no overlay-click-to-close: an admin mid-form shouldn't lose
        // their entered data from a stray click. Close only via the X or Cancel.

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && therapistModal.classList.contains('modal-visible')) {
                closeTherapistModal();
            }
        });

        // Client-side validation — the message goes under the field it belongs to.
        therapistForm.addEventListener('submit', function (e) {
            var ok = window.plForm.requireFields(therapistForm, [
                ['ther-FirstName', @Json.Serialize(L["First name"].Value)],
                ['ther-LastName', @Json.Serialize(L["Last name"].Value)],
                ['ther-Specialty', @Json.Serialize(L["Specialty"].Value)],
                ['ther-PhoneNumber', @Json.Serialize(L["Phone"].Value)],
                ['ther-Email', @Json.Serialize(L["Email"].Value)]
            ]);
            if (!ok) e.preventDefault();
        });

        window.openTherapistModal  = openTherapistModal;
        window.closeTherapistModal = closeTherapistModal;
    })();
</script>

@* Edit Therapist dialog — shared with the Therapist detail page *@
@await Html.PartialAsync("_EditTherapistModal", "Index")
