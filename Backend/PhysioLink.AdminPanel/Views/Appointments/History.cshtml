@model PhysioLink.AdminPanel.ViewModels.AppointmentHistoryViewModel
@using PhysioLink.AdminPanel.Helpers
@{
    ViewData["Title"] = "Appointment History";
    ViewData["ActivePage"] = "Appointments";

    // Terminal outcomes only — values must match PhysioLink.Domain.Enums.AppointmentStatus
    // member names exactly (the API parses this with Enum.TryParse).
    var statusOptions = new[]
    {
        ("Completed", "Completed"),
        ("CancelledByClinic", "Cancelled"),
        ("Rejected", "Rejected"),
        ("Expired", "Expired")
    };
}

@* Appointment history — same data-table card as Patients and Appointments
   (datatable-export design). Read-only archive, so there is no actions column. *@
<div class="dt-card">

    <div class="dt-header">
        <h1 class="dt-title">@L["Appointment History"]</h1>

        <div class="dt-tools">
            <form method="get" asp-action="History" class="dt-filters">
                @* Status filter *@
                <select name="status" class="dt-input dt-select" aria-label="@L["Filter by status"]" onchange="this.form.submit()">
                    <option value="">@L["All outcomes"]</option>
                    @foreach (var (value, label) in statusOptions)
                    {
                        if (Model.StatusFilter == value)
                        {
                            <option value="@value" selected>@L[label]</option>
                        }
                        else
                        {
                            <option value="@value">@L[label]</option>
                        }
                    }
                </select>

                @* Therapist filter *@
                <select name="therapistFilter" class="dt-input dt-select" aria-label="@L["Filter by therapist"]" onchange="this.form.submit()">
                    <option value="">@L["All therapists"]</option>
                    @foreach (var t in Model.Therapists)
                    {
                        var tName = $"{t.FirstName.Trim()} {t.LastName.Trim()}";
                        if (Model.TherapistFilter == tName)
                        {
                            <option value="@tName" selected>@tName</option>
                        }
                        else
                        {
                            <option value="@tName">@tName</option>
                        }
                    }
                </select>

                <input type="hidden" name="page" value="1" />
            </form>

            <a asp-action="Index" asp-controller="Appointments" class="dt-btn dt-btn-outline">
                @L["← Back to appointments"]
            </a>
        </div>
    </div>

    <div class="dt-scroll">
        <table class="dt-table">
            <thead>
                <tr>
                    <th>@L["Date & Time"]</th>
                    <th>@L["Patient"]</th>
                    <th>@L["Therapist"]</th>
                    <th>@L["Title"]</th>
                    <th>@L["Outcome"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Appointments.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-row">@L["No finished appointments match these filters yet."]</td>
                    </tr>
                }
                @foreach (var appt in Model.Appointments)
                {
                    var local = ClinicTime.ToLocal(appt.AppointmentTime);
                    <tr>
                        <td>
                            <span class="dt-cell-main">@local.ToString(DatePatterns.MonthDayYear)</span>
                            <span class="dt-cell-sub" dir="ltr">@local.ToString("HH:mm")</span>
                        </td>
                        <td>
                            <a asp-controller="Patients" asp-action="Detail"
                               asp-route-id="@appt.PatientId"
                               class="dt-name">@appt.PatientName</a>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(appt.TherapistName))
                            {
                                <span class="unassigned-text">—</span>
                            }
                            else
                            {
                                @appt.TherapistName
                            }
                        </td>
                        <td>@appt.Title</td>
                        <td>
                            @await Html.PartialAsync("_DataTableBadge", appt.Status)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_DataTableFooter", new PhysioLink.AdminPanel.ViewModels.Shared.DataTableFooterViewModel
    {
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        ItemCount = Model.Appointments.Count,
        Pagination = Model.Pagination
    })
</div>
