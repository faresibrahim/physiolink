@model PhysioLink.AdminPanel.ViewModels.AppointmentHistoryViewModel
@using PhysioLink.AdminPanel.Helpers
@{
    ViewData["Title"] = "Appointment History";
    ViewData["ActivePage"] = "Appointments";

    // Terminal outcomes only — values must match PhysioLink.Domain.Enums.AppointmentStatus
    // member names exactly (the API parses this with Enum.TryParse).
    var statusOptions = new[]
    {
        ("Completed", "Completed"),
        ("CancelledByClinic", "Cancelled"),
        ("Rejected", "Rejected"),
        ("Expired", "Expired")
    };
}

@* ── Page header ─────────────────────────────────────────────────────────── *@
<div class="page-header">
    <div>
        <h1 class="page-title">@L["Appointment History"]</h1>
        <p class="page-sub">@L[Model.TotalCount == 1 ? "{0} finished appointment on record" : "{0} finished appointments on record", Model.TotalCount]</p>
    </div>
</div>

@* ── Filter bar ──────────────────────────────────────────────────────────── *@
<form method="get" asp-action="History" class="toolbar">

    @* Status filter *@
    <select name="status" class="filter-select" aria-label="@L["Filter by status"]" onchange="this.form.submit()">
        <option value="">@L["All outcomes"]</option>
        @foreach (var (value, label) in statusOptions)
        {
            if (Model.StatusFilter == value)
            {
                <option value="@value" selected>@L[label]</option>
            }
            else
            {
                <option value="@value">@L[label]</option>
            }
        }
    </select>

    @* Therapist filter *@
    <select name="therapistFilter" class="filter-select" aria-label="@L["Filter by therapist"]" onchange="this.form.submit()">
        <option value="">@L["All therapists"]</option>
        @foreach (var t in Model.Therapists)
        {
            var tName = $"{t.FirstName.Trim()} {t.LastName.Trim()}";
            if (Model.TherapistFilter == tName)
            {
                <option value="@tName" selected>@tName</option>
            }
            else
            {
                <option value="@tName">@tName</option>
            }
        }
    </select>

    <input type="hidden" name="page" value="1" />

    <a asp-action="Index" asp-controller="Appointments" class="btn btn-ghost ml-auto">
        @L["← Back to appointments"]
    </a>
</form>

@* ── History table ───────────────────────────────────────────────────────── *@
<div class="card card-flush">
    <div class="table-scroll">
        <table class="data-table data-table-wide">
            <thead>
                <tr>
                    <th>@L["Date & Time"]</th>
                    <th>@L["Patient"]</th>
                    <th>@L["Therapist"]</th>
                    <th>@L["Title"]</th>
                    <th>@L["Outcome"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Appointments.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-row">@L["No finished appointments match these filters yet."]</td>
                    </tr>
                }
                @foreach (var appt in Model.Appointments)
                {
                    var therapist = string.IsNullOrEmpty(appt.TherapistName) ? "—" : appt.TherapistName;
                    <tr>
                        <td>
                            <span class="appt-date">@ClinicTime.ToLocal(appt.AppointmentTime).ToString(DatePatterns.MonthDayYear)</span>
                            <span class="appt-time">@ClinicTime.ToLocal(appt.AppointmentTime).ToString("HH:mm")</span>
                        </td>
                        <td>
                            <a asp-controller="Patients" asp-action="Detail"
                               asp-route-id="@appt.PatientId"
                               class="cell-link">@appt.PatientName</a>
                        </td>
                        <td class="muted-cell">@therapist</td>
                        <td class="primary-cell">@appt.Title</td>
                        <td>
                            @await Html.PartialAsync("_StatusBadge", appt.Status)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Pagination ──────────────────────────────────────────────────────────── *@
@await Html.PartialAsync("_Pagination", Model.Pagination)
