@model PhysioLink.AdminPanel.ViewModels.AppointmentRequestListViewModel
@using PhysioLink.AdminPanel.Helpers

@{
    ViewData["Title"] = "Requests";
    ViewData["ActivePage"] = "Appointments";

    var count = Model.Requests.Count;
}

@* Pending-request queue — same data-table card as Appointments, History and
   Patients (datatable-export design). Accept / Reject stay visible on every row
   rather than behind the "⋮" menu, since deciding is this page's whole job. *@
<div class="dt-card">

    <div class="dt-header">
        <div>
            <h1 class="dt-title">@L["Requests"]</h1>
            <p class="dt-subtitle">@L[count == 1 ? "{0} request waiting on a decision — expired requests are hidden automatically." : "{0} requests waiting on a decision — expired requests are hidden automatically.", count]</p>
        </div>

        <div class="dt-tools">
            <form method="get" asp-action="Requests" class="dt-filters">
                @* Therapist filter *@
                <select name="therapistFilter" class="dt-input dt-select" aria-label="@L["Filter by therapist"]" onchange="this.form.submit()">
                    <option value="" selected="@(Model.TherapistFilter == null)">@L["All therapists"]</option>
                    @foreach (var t in Model.Therapists)
                    {
                        bool active = Model.TherapistFilter == t.Id;
                        <option value="@t.Id" selected="@active">@t.FirstName @t.LastName</option>
                    }
                </select>
            </form>

            <a asp-action="Index" asp-controller="Appointments" class="dt-btn dt-btn-outline">
                @L["← Back to appointments"]
            </a>
        </div>
    </div>

    <div class="dt-scroll">
        <table class="dt-table">
            <thead>
                <tr>
                    <th>@L["Date & Time"]</th>
                    <th>@L["Patient"]</th>
                    <th>@L["Therapist"]</th>
                    <th>@L["Title"]</th>
                    <th>@L["Requested"]</th>
                    <th>@L["Status"]</th>
                    <th class="dt-col-actions">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @if (count == 0)
            {
                <tr>
                    <td colspan="7" class="empty-row">
                        <div class="empty-state">
                            <h2 class="empty-state-title">@L["All caught up"]</h2>
                            <p class="empty-state-subtitle">@L["No pending requests right now."]</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var r in Model.Requests)
            {
                var scheduledLocal = ClinicTime.ToLocal(r.ScheduledAt);
                var requestedLocal = ClinicTime.ToLocal(r.RequestedAt);
                <tr>
                    <td>
                        <span class="dt-cell-main">@scheduledLocal.ToString(DatePatterns.MonthDay)</span>
                        <span class="dt-cell-sub" dir="ltr">@scheduledLocal.ToString("HH:mm")</span>
                    </td>
                    <td>
                        <a asp-controller="Patients" asp-action="Detail" asp-route-id="@r.PatientId" class="dt-name">@r.PatientName</a>
                        @if (!string.IsNullOrWhiteSpace(r.Notes))
                        {
                            <span class="dt-cell-sub dt-cell-note" title="@r.Notes">&ldquo;@r.Notes&rdquo;</span>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrEmpty(r.TherapistName))
                        {
                            <span class="unassigned-text">—</span>
                        }
                        else
                        {
                            @r.TherapistName
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(r.Type))
                        {
                            <span class="unassigned-text">—</span>
                        }
                        else
                        {
                            @r.Type
                        }
                        @if (r.RescheduleFrom is DateTime rescheduleFrom)
                        {
                            <span class="dt-cell-sub">@L["Reschedule · was {0}", ClinicTime.ToLocal(rescheduleFrom).ToString(DatePatterns.MonthDayTime)]</span>
                        }
                    </td>
                    <td>
                        <span class="dt-cell-main">@requestedLocal.ToString(DatePatterns.MonthDay)</span>
                        <span class="dt-cell-sub" dir="ltr">@requestedLocal.ToString("HH:mm")</span>
                    </td>
                    <td>
                        @if (r.RescheduleFrom is not null)
                        {
                            <span class="dt-badge dt-badge-warning">@L["Rescheduled"]</span>
                        }
                        else
                        {
                            @await Html.PartialAsync("_DataTableBadge", "Requested")
                        }
                    </td>
                    <td class="dt-col-actions">
                        <div class="dt-row-actions">
                            <form asp-action="AcceptRequest" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.AppointmentId" />
                                <input type="hidden" name="therapistFilter" value="@Model.TherapistFilter" />
                                <button type="submit" class="dt-btn dt-btn-sm dt-btn-primary">@L["Accept"]</button>
                            </form>
                            <form asp-action="RejectRequest" method="post" class="inline-form"
                                  data-confirm="@L["Reject this request and free the slot?"]" onsubmit="return confirm(this.dataset.confirm);">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.AppointmentId" />
                                <input type="hidden" name="therapistFilter" value="@Model.TherapistFilter" />
                                <button type="submit" class="dt-btn dt-btn-sm dt-btn-danger-outline">@L["Reject"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
