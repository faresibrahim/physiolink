@model PhysioLink.AdminPanel.ViewModels.AppointmentListViewModel
@using PhysioLink.AdminPanel.Helpers
@{
    ViewData["Title"] = "Appointments";
    ViewData["ActivePage"] = "Appointments";

    var prevWeek = Model.WeekStart.AddDays(-7);
    var nextWeek = Model.WeekStart.AddDays(7);
    var weekEnd  = Model.WeekStart.AddDays(6);
}

@* ── Page header ─────────────────────────────────────────────────────────── *@
<div class="page-header">
    <div>
        <h1 class="page-title">Appointments</h1>
        <p class="page-sub">@Model.TotalAppointmentCount appointment@(Model.TotalAppointmentCount == 1 ? "" : "s") this week</p>
    </div>
</div>

@* ── Filter / navigation bar ─────────────────────────────────────────────── *@
<form method="get" asp-action="Index" class="toolbar">

    @* Week navigator *@
    <div class="appt-week-nav">
        <a asp-action="Index"
           asp-route-weekStart="@prevWeek.ToString("yyyy-MM-dd")"
           asp-route-status="@Model.StatusFilter"
           asp-route-therapistFilter="@Model.TherapistFilter"
           asp-route-viewMode="@Model.ViewMode"
           class="appt-week-arrow" aria-label="Previous week">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </a>

        <span class="appt-week-label">
            @Model.WeekStart.ToString("MMM d") – @weekEnd.ToString("MMM d, yyyy")
        </span>

        <a asp-action="Index"
           asp-route-weekStart="@nextWeek.ToString("yyyy-MM-dd")"
           asp-route-status="@Model.StatusFilter"
           asp-route-therapistFilter="@Model.TherapistFilter"
           asp-route-viewMode="@Model.ViewMode"
           class="appt-week-arrow" aria-label="Next week">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
    </div>

    @* Today shortcut — standalone pill *@
    <a asp-action="Index"
       asp-route-status="@Model.StatusFilter"
       asp-route-therapistFilter="@Model.TherapistFilter"
       asp-route-viewMode="@Model.ViewMode"
       class="appt-today-btn">Today</a>

    @* Status filter *@
    <select name="status" class="filter-select" aria-label="Filter by status" onchange="this.form.submit()">
        <option value="">Status</option>
        @{
            // Values must match PhysioLink.Domain.Enums.AppointmentStatus member
            // names exactly — the API parses this filter with Enum.TryParse.
            // Completed is intentionally omitted — a completed appointment is always
            // past its due date, so it lives in History, never on the board.
            var statusOptions = new[]
            {
                ("Requested", "Pending"),
                ("Confirmed", "Confirmed"),
                ("Rejected", "Rejected"),
                ("Expired", "Expired"),
                ("CancelledByClinic", "Cancelled")
            };
        }
        @foreach (var (value, label) in statusOptions)
        {
            if (Model.StatusFilter == value)
            {
                <option value="@value" selected>@label</option>
            }
            else
            {
                <option value="@value">@label</option>
            }
        }
    </select>

    @* Therapist filter *@
    <select name="therapistFilter" class="filter-select" aria-label="Filter by therapist" onchange="this.form.submit()">
        <option value="">All Therapists</option>
        @foreach (var t in Model.Therapists)
        {
            var tName = $"{t.FirstName.Trim()} {t.LastName.Trim()}";
            if (Model.TherapistFilter == tName)
            {
                <option value="@tName" selected>@tName</option>
            }
            else
            {
                <option value="@tName">@tName</option>
            }
        }
    </select>

    <input type="hidden" name="weekStart"  value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="viewMode"   value="@Model.ViewMode" />
    <input type="hidden" name="page"       value="1" />

    <a asp-action="History" asp-controller="Appointments" class="btn btn-ghost ml-auto">
        History
    </a>

    <button type="button" onclick="openAppointmentModal()" class="btn btn-primary">
        + New Appointment
    </button>
</form>

@* ── Appointments table ───────────────────────────────────────────────────── *@
<div class="card card-flush">
    <table class="data-table">
        <thead>
            <tr>
                <th>Date &amp; Time</th>
                <th>Patient</th>
                <th>Therapist</th>
                <th>Title</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Appointments.Any())
            {
                <tr>
                    <td colspan="6" class="empty-row">No appointments found for this week.</td>
                </tr>
            }
            @foreach (var appt in Model.Appointments)
            {
                var therapist = string.IsNullOrEmpty(appt.TherapistName) ? "—" : appt.TherapistName;
                <tr>
                    <td>
                        <span class="appt-date">@ClinicTime.ToLocal(appt.AppointmentTime).ToString("MMM d")</span>
                        <span class="appt-time-chip">@ClinicTime.ToLocal(appt.AppointmentTime).ToString("HH:mm")</span>
                    </td>
                    <td class="primary-cell">@appt.PatientName</td>
                    <td class="muted-cell">@therapist</td>
                    <td class="primary-cell">@appt.Title</td>
                    <td>
                        @await Html.PartialAsync("_StatusBadge", appt.Status)
                    </td>
                    <td>
                        <div class="row-actions">
                            @* Edit is the priority action on this page — full-size text button, first. *@
                            <button type="button" class="btn btn-ghost btn-xs" aria-label="Edit appointment"
                                    onclick="openEditAppointmentModal('@appt.AppointmentId')">
                                Edit
                            </button>
                            @* View patient is secondary here — icon-only. *@
                            <a asp-controller="Patients" asp-action="Detail"
                               asp-route-id="@appt.PatientId"
                               class="icon-btn" aria-label="View patient">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ── Pagination ───────────────────────────────────────────────────────────── *@
@await Html.PartialAsync("_Pagination", Model.Pagination)



<div class="modal-overlay" id="appointmentModal" aria-modal="true" role="dialog" aria-labelledby="appointmentModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="appointmentModalTitle">New Appointment</h2>
                <p class="modal-subtitle" id="appointmentModalSubtitle">Book a new appointment for a patient.</p>
            </div>
            <button type="button" class="modal-close" onclick="closeAppointmentModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        @* --- Status actions (edit mode only) -----------------------------------
           Status changes go through the guarded Confirm / Reject / Cancel endpoints,
           never a free-form dropdown. Each is its own form (kept OUTSIDE the details
           form below, since HTML forms can't nest). JS reveals only the buttons that
           are valid for the loaded appointment's current status. *@
        <div class="modal-status-bar" id="statusActions" style="display:none;">
            <div class="modal-status-current">
                <span class="modal-status-label">Status</span>
                <span id="statusActionBadge"></span>
            </div>
            <div class="modal-status-buttons">
                <form asp-action="Confirm" method="post" class="inline-form" id="confirmForm" style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="confirmId" />
                    <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                    <input type="hidden" name="therapistFilter" value="@Model.TherapistFilter" />
                    <button type="submit" class="btn btn-success btn-sm">Confirm</button>
                </form>
                <form asp-action="Reject" method="post" class="inline-form" id="rejectForm" style="display:none;"
                      onsubmit="return confirm('Reject this request and free the slot?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="rejectId" />
                    <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                    <input type="hidden" name="therapistFilter" value="@Model.TherapistFilter" />
                    <button type="submit" class="btn btn-danger-outline btn-sm">Reject</button>
                </form>
                @* Backing form for the footer "Cancel appointment" button (submitted
                   via its form="cancelForm" attribute). Inputs only — no visible content. *@
                <form asp-action="CancelConfirmed" method="post" class="inline-form" id="cancelForm" style="display:none;"
                      onsubmit="return confirm('Cancel this confirmed appointment and free the slot?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="cancelId" />
                    <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                    <input type="hidden" name="therapistFilter" value="@Model.TherapistFilter" />
                </form>
                <span id="statusActionNone" class="modal-status-note" style="display:none;">No further actions available.</span>
            </div>
        </div>

        <form method="post" asp-action="Create" asp-controller="Appointments" class="modal-form" id="appointmentForm">
            @Html.AntiForgeryToken()

            @* Hidden fields *@
            <input type="hidden" id="AppointmentId" name="AppointmentId" value="" disabled />

            @* --- Patient picker (create mode only) --- *@
            <div class="form-group" id="patientPickerGroup">
                <label class="form-label" for="PatientId">Patient</label>
                <select id="PatientId" name="PatientId" class="form-input">
                    <option value="">— Select a patient —</option>
                    @foreach (var patient in Model.Patients)
                    {
                        <option value="@patient.PatientId">
                            @patient.FirstName @patient.LastName
                        </option>
                    }
                </select>
            </div>

            @* --- Patient name display (edit mode only) --- *@
            <div class="form-group" id="patientNameGroup" style="display:none;">
                <label class="form-label">Patient</label>
                <p id="EditPatientName" class="static-value"></p>
            </div>

            @* --- Title --- *@
            <div class="form-group">
                <label class="form-label" for="ApptTitle">Title</label>
                <input type="text" id="ApptTitle" name="Title" class="form-input"
                       placeholder="e.g. Follow-up, Initial Assessment, Discharge" />
            </div>

            @* --- Therapist name --- *@
            <div class="form-group">
                <label class="form-label" for="ApptTherapistName">Therapist</label>
                <select id="ApptTherapistName" name="TherapistName" class="form-input">
                    <option value="">— Select a therapist —</option>
                    @foreach (var therapist in Model.Therapists)
                    {
                        <option value="@therapist.FirstName.Trim() @therapist.LastName.Trim()">
                            @therapist.FirstName.Trim() @therapist.LastName.Trim()
                        </option>
                    }
                </select>
            </div>

            @* --- Appointment date + time --- *@
            <div class="form-group">
                <label class="form-label" for="AppointmentTime">Date &amp; Time</label>
                <input type="datetime-local" id="AppointmentTime" name="AppointmentTime" class="form-input" />
            </div>

            @* Shown in edit mode once the appointment is no longer pending. *@
            <p id="lockedFieldsNote" class="form-hint" style="display:none;">
                Therapist and date are locked once an appointment is confirmed, completed, or cancelled — you can still edit the title and notes.
            </p>

            @* --- Notes --- *@
            <div class="form-group">
                <label class="form-label" for="ApptNotes">Notes <span class="label-optional">(optional)</span></label>
                <textarea id="ApptNotes" name="Notes" class="form-input" rows="3"
                          placeholder="Any additional notes..."></textarea>
            </div>

            @* Status is never edited from this form — it changes only through the
               Confirm / Reject / Cancel actions in the table. The current value is
               carried through unchanged so saving details doesn't reset it. *@
            <input type="hidden" id="ApptStatus" name="Status" value="Requested" />

            <div class="modal-actions">
                @* Modal-dismiss — create mode only; hidden in edit mode (the header X still closes). *@
                <button type="button" id="ghostCancelBtn" class="btn btn-ghost" onclick="closeAppointmentModal()">Cancel</button>
                @* Cancel the appointment — edit mode, Confirmed only. Submits #cancelForm. *@
                <button type="submit" form="cancelForm" id="footerCancelApptBtn" class="btn btn-danger-outline" style="display:none;">Cancel appointment</button>
                <button type="submit" id="appointmentSubmitBtn" class="btn btn-primary">Book Appointment</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        function init() {
            var modalEl = document.getElementById('appointmentModal');
            if (!modalEl) { console.error('[appt] #appointmentModal not found'); return; }

            var formEl = document.getElementById('appointmentForm');
            if (!formEl) { console.error('[appt] #appointmentForm not found'); return; }

            var patientTomSelect = null;

            // Patient → therapist name lookup (serialized server-side for safety)
            var patientTherapistMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Patients.ToDictionary(
                    p => p.PatientId.ToString(),
                    p => (p.TherapistName ?? string.Empty).Trim()
                )
            ));

            function applyPatientTherapist(patientId) {
                if (!patientId) return;
                var therapistName = patientTherapistMap[patientId] || '';
                var therapistSelect = document.getElementById('ApptTherapistName');
                therapistSelect.value = therapistName;
                // If the exact value isn't in the option list (whitespace mismatch, deleted therapist),
                // fall back to scanning options by trimmed text match.
                if (therapistName && therapistSelect.value !== therapistName) {
                    for (var i = 0; i < therapistSelect.options.length; i++) {
                        if (therapistSelect.options[i].value.trim() === therapistName) {
                            therapistSelect.selectedIndex = i;
                            break;
                        }
                    }
                }
            }

            // Initialise TomSelect on patient picker
            if (typeof TomSelect !== 'undefined') {
                try {
                    patientTomSelect = new TomSelect('#PatientId', {
                        placeholder: 'Search patients...',
                        searchField: 'text',
                        maxOptions: 300,
                        onChange: function (value) {
                            applyPatientTherapist(value);
                        }
                    });
                } catch (e) {
                    console.warn('[appt] TomSelect failed:', e);
                }
            }

            // --- Status action wiring (edit mode) -------------------------
            // Reveals only the transitions valid for the current status:
            //   Requested -> Confirm / Reject,  Confirmed -> Cancel,  else none.
            function applyStatusActions(appointmentId, status) {
                document.getElementById('confirmId').value = appointmentId;
                document.getElementById('rejectId').value  = appointmentId;
                document.getElementById('cancelId').value  = appointmentId;

                var labels = { 'Requested': 'Pending', 'CancelledByClinic': 'Cancelled' };
                var badge = document.getElementById('statusActionBadge');
                badge.className = 'status-pill status-' + String(status).toLowerCase();
                badge.textContent = labels[status] || status;

                var isRequested = status === 'Requested';
                var isConfirmed = status === 'Confirmed';

                document.getElementById('confirmForm').style.display    = isRequested ? 'inline-flex' : 'none';
                document.getElementById('rejectForm').style.display     = isRequested ? 'inline-flex' : 'none';
                // The "Cancel appointment" button now lives in the footer next to Save Changes.
                document.getElementById('footerCancelApptBtn').style.display = isConfirmed ? 'inline-flex' : 'none';
                document.getElementById('statusActionNone').style.display =
                    (isRequested || isConfirmed) ? 'none' : 'inline';

                // Field locking: only a pending (Requested) appointment is fully editable.
                // Once confirmed / completed / cancelled / etc., freeze the therapist and
                // date; title and notes stay editable.
                var fieldsLocked = !isRequested;
                document.getElementById('ApptTherapistName').disabled = fieldsLocked;
                document.getElementById('AppointmentTime').disabled   = fieldsLocked;
                document.getElementById('lockedFieldsNote').style.display = fieldsLocked ? 'block' : 'none';
            }

            // --- Mode switcher --------------------------------------------
            function setModalMode(mode) {
                var isEdit = mode === 'edit';

                formEl.action = isEdit ? '/Appointments/Edit' : '/Appointments/Create';

                document.getElementById('patientPickerGroup').style.display = isEdit ? 'none'  : 'block';
                document.getElementById('patientNameGroup').style.display   = isEdit ? 'block' : 'none';
                document.getElementById('statusActions').style.display      = isEdit ? 'flex'  : 'none';
                document.getElementById('AppointmentId').disabled           = !isEdit;

                document.getElementById('appointmentModalTitle').textContent =
                    isEdit ? 'Edit Appointment' : 'New Appointment';
                document.getElementById('appointmentModalSubtitle').textContent =
                    isEdit ? 'Update appointment details.' : 'Book a new appointment for a patient.';
                document.getElementById('appointmentSubmitBtn').textContent =
                    isEdit ? 'Save Changes' : 'Book Appointment';

                // Footer buttons: the ghost dismiss shows only in create mode; the
                // "Cancel appointment" action is edit-only and driven by applyStatusActions
                // (called before this in the edit flow), so only force-hide it in create mode.
                document.getElementById('ghostCancelBtn').style.display = isEdit ? 'none' : 'inline-flex';
                if (!isEdit) {
                    document.getElementById('footerCancelApptBtn').style.display = 'none';
                    // Create mode is always fully editable — clear any locks left from a prior edit.
                    document.getElementById('ApptTherapistName').disabled = false;
                    document.getElementById('AppointmentTime').disabled   = false;
                    document.getElementById('lockedFieldsNote').style.display = 'none';
                }
            }

            // --- Open create mode ----------------------------------------
            function openAppointmentModal() {
                setModalMode('create');
                modalEl.classList.add('modal-visible');
            }

            // --- Open edit mode ------------------------------------------
            async function openEditAppointmentModal(appointmentId) {
                try {
                    var response = await fetch('/Appointments/GetById/' + encodeURIComponent(appointmentId));
                    if (!response.ok) { alert('Could not load appointment.'); return; }
                    var data = await response.json();
                    if (data.error) { alert('Could not load appointment.'); return; }

                    document.getElementById('AppointmentId').value        = data.appointmentId;
                    document.getElementById('EditPatientName').textContent = data.patientName;
                    document.getElementById('ApptTitle').value             = data.title          || '';
                    document.getElementById('ApptTherapistName').value     = data.therapistName  || '';
                    document.getElementById('ApptNotes').value             = data.notes          || '';
                    document.getElementById('ApptStatus').value            = data.status         || 'Requested';

                    if (data.appointmentTime) {
                        document.getElementById('AppointmentTime').value =
                            String(data.appointmentTime).substring(0, 16);
                    }

                    applyStatusActions(data.appointmentId, data.status || 'Requested');

                    setModalMode('edit');
                    modalEl.classList.add('modal-visible');
                } catch (err) {
                    console.error('[appt] failed to load appointment:', err);
                    alert('Could not load appointment.');
                }
            }

            // --- Close ---------------------------------------------------
            function closeAppointmentModal() {
                modalEl.classList.remove('modal-visible');
                formEl.reset();
                if (patientTomSelect) patientTomSelect.clear();
                document.getElementById('ApptTherapistName').value = '';
                setModalMode('create');
            }

            // Expose for inline onclick handlers
            window.openAppointmentModal     = openAppointmentModal;
            window.openEditAppointmentModal = openEditAppointmentModal;
            window.closeAppointmentModal    = closeAppointmentModal;

            // Close on overlay click
            modalEl.addEventListener('click', function (e) {
                if (e.target === modalEl) closeAppointmentModal();
            });

            // Submit validation
            formEl.addEventListener('submit', function (e) {
                var isEdit = formEl.action.indexOf('Edit') !== -1;
                if (!isEdit && !document.getElementById('PatientId').value) {
                    e.preventDefault();
                    alert('Please select a patient.');
                    return;
                }
                if (!document.getElementById('AppointmentTime').value) {
                    e.preventDefault();
                    alert('Please select a date and time.');
                    return;
                }
                // Locked fields are disabled so they can't be changed, but disabled
                // controls aren't posted — re-enable them right before submit so their
                // (unchanged) values are sent and not wiped server-side.
                document.getElementById('ApptTherapistName').disabled = false;
                document.getElementById('AppointmentTime').disabled   = false;
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
