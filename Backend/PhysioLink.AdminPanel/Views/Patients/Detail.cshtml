@model PhysioLink.AdminPanel.ViewModels.PatientDetailViewModel
@{
    ViewData["Title"] = "Patient Detail";
    ViewData["ActivePage"] = "Patients";
}

@* =========================================================================
   PAGE HEADER — title row above the two-column layout
   ========================================================================= *@
<a asp-action="Index" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    Back to Patients
</a>

<div class="detail-grid">

    @* =====================================================================
       LEFT COLUMN — profile, exercises
       ===================================================================== *@
    <div class="detail-main">

        @* --- Profile card ---------------------------------------------- *@
        <div class="card">
            <div class="profile-header">
                <div class="profile-id">
                    <div class="avatar avatar-lg">
                        @Model.Patient.FirstName[0]@Model.Patient.LastName[0]
                    </div>
                    <div>
                        <h2 class="profile-name">@Model.Patient.FirstName @Model.Patient.LastName</h2>
                        <p class="profile-meta">@Model.Patient.Diagnosis</p>
                        @await Html.PartialAsync("_StatusBadge", Model.Patient.IsActive ? "Active" : "Inactive")
                    </div>
                </div>

                <div class="profile-actions">
                    <button type="button" class="btn btn-ghost btn-sm" onclick="openEditPatientModal()">
                        Edit Patient
                    </button>
                </div>
            </div>

            <div class="profile-divider"></div>

            <div class="profile-info-row">
                <div class="info-item">
                    <p class="info-label">Phone</p>
                    <p class="info-value">@Model.Patient.PhoneNumber</p>
                </div>
                <div class="info-item">
                    <p class="info-label">Email</p>
                    <p class="info-value">@Model.Patient.Email</p>
                </div>
                <div class="info-item">
                    <p class="info-label">Clinic</p>
                    <p class="info-value">@Model.Patient.ClinicName</p>
                </div>
                <div class="info-item">
                    <p class="info-label">Assigned Therapist</p>
                    <p class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Patient.TherapistName))
                        {
                            <span class="therapist-chip">@Model.Patient.TherapistName</span>
                        }
                        else
                        {
                            <span class="unassigned-text">Unassigned</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        @* --- Assigned Exercises ---------------------------------------- *@
        <div class="card">
            <div class="card-header-row">
                <div>
                    <h3 class="card-title">Assigned Exercises</h3>
                    <p class="card-subtitle">@Model.Patient.Exercises.Count active programs · personalized per patient</p>
                </div>
                <button type="button" onclick="openAssignModal()" class="btn btn-primary btn-sm">
                    + Assign Exercise
                </button>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Exercise</th>
                        <th>Sets × Reps</th>
                        <th>Duration</th>
                        <th>Feedback</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Patient.Exercises.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-row">No exercises assigned.</td>
                        </tr>
                    }
                    @foreach (var exercise in Model.Patient.Exercises)
                    {
                        <tr>
                            <td class="primary-cell">@exercise.ExerciseName</td>
                            <td class="muted-cell">@exercise.Sets × @exercise.Reps</td>
                            <td class="muted-cell">@exercise.DurationMinutes min</td>
                            <td class="muted-cell">
                                @if (exercise.Feedback.HasValue)
                                {
                                    var fbVal = exercise.Feedback.Value;
                                    var fbClass = fbVal <= 3 ? "fb-score-easy" : fbVal <= 6 ? "fb-score-moderate" : "fb-score-hard";
                                    var fbLabel = fbVal switch {
                                        1 => "Very Easy", 2 => "Easy", 3 => "Fairly Easy",
                                        4 => "Somewhat Easy", 5 => "Moderate", 6 => "Somewhat Hard",
                                        7 => "Fairly Hard", 8 => "Hard", 9 => "Very Hard",
                                        10 => "Maximum Effort", _ => $"Level {fbVal}"
                                    };
                                    <span class="fb-score @fbClass">@fbVal</span>
                                    <span class="muted-cell"> · @fbLabel</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>
                                @await Html.PartialAsync("_StatusBadge", exercise.Status)
                            </td>
                            <td>
                                <button type="button" class="btn btn-ghost btn-xs"
                                        onclick="openEditModal('@exercise.ExerciseAssignmentId')">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-danger-outline btn-xs"
                                        onclick="confirmUnassign('@exercise.ExerciseAssignmentId', '@exercise.ExerciseName.Replace("\\", "\\\\").Replace("'", "\\'")')">
                                    Unassign
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
        

    @* =====================================================================
       RIGHT COLUMN — sidebar (stats, appointments, danger zone)
       ===================================================================== *@
    <aside class="detail-sidebar">

        @* --- Danger zone ----------------------------------------------- *@
        <div class="card danger-card">
            <h4 class="danger-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Deactivate Patient
            </h4>
            <p class="danger-text">Patient will lose access to the app and exercise programs. Data is retained.</p>
            <button type="button" class="btn btn-danger btn-block" onclick="openDeactivateModal()">
                Deactivate Account
            </button>
        </div>

    </aside>
</div>

@* ── Edit Patient Modal ───────────────────────────────────────────────── *@
@await Html.PartialAsync("_EditPatientModal", new PatientFormViewModel
{
    PatientId   = Model.Patient.PatientId,
    FirstName   = Model.Patient.FirstName,
    LastName    = Model.Patient.LastName,
    Email       = Model.Patient.Email,
    PhoneNumber = Model.Patient.PhoneNumber,
    Diagnosis   = Model.Patient.Diagnosis,
    IsActive    = Model.Patient.IsActive,
    TherapistId = Model.PatientTherapistId,
    IsEdit      = true,
    Therapists  = Model.Therapists
})

@* =========================================================================
   DEACTIVATE PATIENT MODAL — re-authentication gate on a destructive action.
   The therapist must retype their own account password; the controller verifies
   it against the API before the patient is deactivated.
   ========================================================================= *@
<div class="modal-overlay" id="deactivatePatientModal" aria-modal="true" role="dialog" aria-labelledby="deactivatePatientModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="deactivatePatientModalTitle">Deactivate Patient</h2>
                <p class="modal-subtitle">@Model.Patient.FirstName @Model.Patient.LastName</p>
            </div>
            <button type="button" class="modal-close" onclick="closeDeactivateModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Deactivate" asp-controller="Patients" asp-route-id="@Model.Patient.PatientId" class="modal-form" id="deactivatePatientForm">
            @Html.AntiForgeryToken()

            <div class="alert alert-error" role="alert">
                <div class="alert-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <span>
                    @Model.Patient.FirstName will immediately lose access to the app and to all
                    assigned exercise programs. Records and history are retained.
                </span>
            </div>

            <div class="form-group">
                <label class="form-label" for="deactivatePassword">Your account password</label>
                <input type="password" id="deactivatePassword" name="password" class="form-input" autocomplete="current-password" />
                <span class="form-hint">Confirm it's you — enter the password you sign in with.</span>
                <span class="field-error" id="deactivatePasswordError" style="display:none;">Enter your password to continue.</span>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeDeactivateModal()">Cancel</button>
                <button type="submit" class="btn btn-danger">Deactivate Account</button>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var deactivateModal = document.getElementById('deactivatePatientModal');
        var deactivateForm  = document.getElementById('deactivatePatientForm');
        var passwordInput   = document.getElementById('deactivatePassword');
        var passwordError   = document.getElementById('deactivatePasswordError');
        if (!deactivateModal || !deactivateForm) return;

        function openDeactivateModal() {
            deactivateModal.classList.add('modal-visible');
            passwordInput.focus();
        }

        function closeDeactivateModal() {
            deactivateModal.classList.remove('modal-visible');
            // Never leave the password sitting in the DOM after the dialog closes
            passwordInput.value = '';
            passwordError.style.display = 'none';
        }

        // Close on overlay click
        deactivateModal.addEventListener('click', function (e) {
            if (e.target === deactivateModal) closeDeactivateModal();
        });

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && deactivateModal.classList.contains('modal-visible')) {
                closeDeactivateModal();
            }
        });

        deactivateForm.addEventListener('submit', function (e) {
            if (!passwordInput.value) {
                e.preventDefault();
                passwordError.style.display = 'block';
                passwordInput.focus();
            }
        });

        passwordInput.addEventListener('input', function () {
            passwordError.style.display = 'none';
        });

        window.openDeactivateModal  = openDeactivateModal;
        window.closeDeactivateModal = closeDeactivateModal;
    })();
</script>

@* =========================================================================
   ASSIGN EXERCISE MODAL
   ========================================================================= *@
<div class="modal-overlay" id="assignModal" aria-modal="true" role="dialog" aria-labelledby="assignModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="assignModalTitle">Assign Exercise</h2>
                <p class="modal-subtitle">Add an exercise from the library to @Model.Patient.FirstName's program.</p>
            </div>
            <button type="button" class="modal-close" onclick="closeAssignModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Create" asp-controller="Assignment" class="modal-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="PatientId" value="@Model.Patient.PatientId" />
            <input type="hidden" name="TherapistName" value="@Model.Patient.TherapistName" />
            <input type="hidden" id="ExerciseAssignmentId" name="ExerciseAssignmentId" value="" disabled />

            @* Create mode — exercise picker *@
            <div class="form-group" id="exercisePickerGroup">
                <label class="form-label" for="ExerciseId">Exercise</label>
                <select id="ExerciseId" name="ExerciseId" class="form-input">
                    <option value="">— Select an exercise —</option>
                    @foreach (var exercise in Model.Exercises)
                    {
                        <option value="@exercise.ExerciseId">
                            @exercise.Name
                        </option>
                    }
                </select>
            </div>

            @* Edit mode — exercise name display (read-only) *@
            <div class="form-group" id="exerciseNameGroup" style="display:none;">
                <label class="form-label">Exercise</label>
                <p id="EditExerciseName" class="static-value"></p>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="Sets">Sets</label>
                    <input type="number" id="Sets" name="Sets" class="form-input" value="3" min="1" max="20" />
                    <span class="form-hint">Default: 3 — adjust for this patient</span>
                </div>
                <div class="form-group">
                    <label class="form-label" for="Reps">Reps</label>
                    <input type="number" id="Reps" name="Reps" class="form-input" value="10" min="1" max="100" />
                    <span class="form-hint">Default: 10 — adjust for this patient</span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="DurationMinutes">Duration (minutes)</label>
                    <input type="number" id="DurationMinutes" name="DurationMinutes" class="form-input" value="30" min="1" max="120" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="FrequencyPerWeek">Frequency Per Week</label>
                    <input type="number" id="FrequencyPerWeek" name="FrequencyPerWeek" class="form-input" value="3" min="1" max="7" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="FrequencyPerDay">Frequency Per Day <span class="form-hint">(optional)</span></label>
                <input type="number" id="FrequencyPerDay" name="FrequencyPerDay" class="form-input" min="1" max="10" placeholder="Optional" />
                <span class="form-hint">How many times per day — leave blank if not applicable</span>
            </div>

            <div class="form-group">
                <label class="form-label" for="Status">Status</label>
                <select id="Status" name="Status" class="form-input">
                    <option value="Active" selected>Active</option>
                    <option value="Paused">Paused</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeAssignModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Assign Exercise</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        function init() {
            var modalEl = document.getElementById('assignModal');
            if (!modalEl) {
                console.error('[assign] #assignModal element not found in DOM');
                return;
            }

            var formEl = modalEl.querySelector('form');
            if (!formEl) {
                console.error('[assign] form not found inside #assignModal');
                return;
            }

            var tomSelect = null;

            function setModalMode(mode) {
                var isEdit = mode === 'edit';

                formEl.action = isEdit ? '/Assignment/Edit' : '/Assignment/Create';

                var picker = document.getElementById('exercisePickerGroup');
                var nameGroup = document.getElementById('exerciseNameGroup');
                var idInput = document.getElementById('ExerciseAssignmentId');
                var titleEl = document.getElementById('assignModalTitle');
                var submitBtn = modalEl.querySelector('.btn-primary[type="submit"]');

                if (picker)    picker.style.display    = isEdit ? 'none' : 'block';
                if (nameGroup) nameGroup.style.display = isEdit ? 'block' : 'none';
                if (idInput)   idInput.disabled        = !isEdit;
                if (titleEl)   titleEl.textContent     = isEdit ? 'Edit Assignment' : 'Assign Exercise';
                if (submitBtn) submitBtn.textContent   = isEdit ? 'Save Changes' : 'Assign Exercise';
            }

            function openAssignModal() {
                setModalMode('create');
                modalEl.classList.add('modal-visible');
            }

            async function openEditModal(assignmentId) {
                try {
                    var response = await fetch('/Assignment/GetById/' + encodeURIComponent(assignmentId));
                    if (!response.ok) {
                        alert('Could not load assignment.');
                        return;
                    }
                    var data = await response.json();
                    if (data.error) {
                        alert('Could not load assignment.');
                        return;
                    }

                    document.getElementById('ExerciseAssignmentId').value = data.exerciseAssignmentId;
                    document.getElementById('EditExerciseName').textContent = data.exerciseName;
                    document.getElementById('Sets').value = data.sets;
                    document.getElementById('Reps').value = data.reps;
                    document.getElementById('DurationMinutes').value = data.durationMinutes;
                    document.getElementById('FrequencyPerWeek').value = data.frequencyPerWeek;
                    document.getElementById('FrequencyPerDay').value = data.frequencyPerDay != null ? data.frequencyPerDay : '';
                    document.getElementById('Status').value = data.status;

                    setModalMode('edit');
                    modalEl.classList.add('modal-visible');
                } catch (err) {
                    console.error('[assign] failed to load assignment:', err);
                    alert('Could not load assignment.');
                }
            }

            function closeAssignModal() {
                modalEl.classList.remove('modal-visible');
                formEl.reset();
                if (tomSelect) tomSelect.clear();
                setModalMode('create');
            }

            // Expose for inline onclick handlers in the markup
            window.openAssignModal  = openAssignModal;
            window.openEditModal    = openEditModal;
            window.closeAssignModal = closeAssignModal;

            // Initialise TomSelect on the exercise picker (optional)
            if (typeof TomSelect !== 'undefined') {
                try {
                    tomSelect = new TomSelect('#ExerciseId', {
                        placeholder: 'Search exercise library...',
                        searchField: 'text',
                        maxOptions: 500
                    });
                } catch (e) {
                    console.warn('[assign] TomSelect failed to initialise:', e);
                }
            }

            // Close when clicking the overlay (but not the modal content)
            modalEl.addEventListener('click', function (e) {
                if (e.target === modalEl) closeAssignModal();
            });

            // Submit validation
            formEl.addEventListener('submit', function (e) {
                var isEdit = formEl.action.indexOf('Edit') !== -1;
                var picker = document.getElementById('ExerciseId');
                if (!isEdit && picker && !picker.value) {
                    e.preventDefault();
                    alert('Please select an exercise.');
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>

@* ── Unassign Exercise (hidden form, confirm-then-submit) ────────────────── *@
<form method="post" asp-action="Unassign" asp-controller="Assignment" id="unassignForm" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="patientId" value="@Model.Patient.PatientId" />
    <input type="hidden" name="id" id="UnassignAssignmentId" />
</form>

<script>
    function confirmUnassign(assignmentId, exerciseName) {
        if (!confirm('Unassign "' + exerciseName + '" from this patient\'s program?')) return;
        document.getElementById('UnassignAssignmentId').value = assignmentId;
        document.getElementById('unassignForm').submit();
    }
</script>