@model PhysioLink.AdminPanel.ViewModels.PatientListViewModel
@{

    ViewData["Title"] = "Patients";
    ViewData["ActivePage"] = "Patients";


    var createdUsername = TempData["PatientCreatedUsername"] as string;
    var createdPassword = TempData["PatientCreatedPassword"] as string;
    var showCredentials = !string.IsNullOrEmpty(createdPassword);

    // Set after a patient is deactivated from their detail page (empty = name unknown).
    var deactivatedName = TempData["PatientDeactivatedName"] as string;
    var showDeactivated = deactivatedName != null;

    var isFiltered = !string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.SelectedTherapistId != null;
}

@* Patients table — adapted from the Sneat "Table Basic" card (datatable-export/):
   one card with the title and controls in its header, the table, and a footer
   with the entry count and pagination. The name column is plain text (the
   template's per-row icons and avatars are left out). *@
<div class="dt-card">

    <div class="dt-header">
        <h1 class="dt-title">@L["Patients"]</h1>

        <div class="dt-tools">
            <form method="get" asp-action="Index" class="dt-filters" role="search">
                <div class="dt-search">
                    <svg class="dt-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text"
                           name="searchQuery"
                           value="@Model.SearchQuery"
                           placeholder="@L["Search by name..."]"
                           aria-label="@L["Search by name..."]"
                           class="dt-input dt-search-input"
                           autocomplete="off" />
                </div>

                <select name="therapistId"
                        onchange="this.form.submit()"
                        class="dt-input dt-select"
                        aria-label="@L["Filter by therapist"]">
                    <option value="">@L["All therapists"]</option>
                    @foreach (var therapist in Model.Therapists)
                    {
                        if (therapist.Id == Model.SelectedTherapistId)
                        {
                            <option value="@therapist.Id" selected>@therapist.FirstName.Trim() @therapist.LastName.Trim()</option>
                        }
                        else
                        {
                            <option value="@therapist.Id">@therapist.FirstName.Trim() @therapist.LastName.Trim()</option>
                        }
                    }
                </select>

                <button type="submit" class="dt-btn dt-btn-outline">@L["Search"]</button>
            </form>

            <button type="button" onclick="openPatientModal()" class="dt-btn dt-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                @L["New patient"]
            </button>
        </div>
    </div>

    <div class="dt-scroll">
        <table class="dt-table">
            <thead>
                <tr>
                    <th>@L["Patient"]</th>
                    <th>@L["Therapist"]</th>
                    <th>@L["Phone"]</th>
                    <th>@L["Status"]</th>
                    <th class="dt-col-actions">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>

            @* An empty list means two different things: nothing matched the
               filters, or the clinic has no patients yet. Each needs its own
               way out. *@
            @if (Model.Patients.Count == 0)
            {
                <tr>
                    <td colspan="5" class="empty-row">
                        <div class="empty-state">
                            @if (isFiltered)
                            {
                                <h2 class="empty-state-title">@L["No patients match these filters"]</h2>
                                <p class="empty-state-subtitle">@L["Try a different name, or clear the filters to see everyone."]</p>
                                <div class="empty-state-action">
                                    <a asp-action="Index" class="btn btn-ghost btn-sm">@L["Clear filters"]</a>
                                </div>
                            }
                            else
                            {
                                <h2 class="empty-state-title">@L["No patients yet"]</h2>
                                <p class="empty-state-subtitle">@L["Add your first patient to start assigning exercises."]</p>
                                <div class="empty-state-action">
                                    <button type="button" onclick="openPatientModal()" class="btn btn-primary btn-sm">@L["New patient"]</button>
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            }

            @foreach (var patient in Model.Patients)
            {
                <tr>
                    <td>
                        <a asp-action="Detail" asp-route-id="@patient.PatientId" class="dt-name">@patient.FirstName @patient.LastName</a>
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(patient.TherapistName))
                        {
                            <span class="unassigned-text">@L["Unassigned"]</span>
                        }
                        else
                        {
                            @patient.TherapistName
                        }
                    </td>
                    <td><span dir="ltr">@patient.PhoneNumber</span></td>
                    <td>
                        @await Html.PartialAsync("_DataTableBadge", patient.IsActive ? "Active" : "Inactive")
                    </td>
                    <td class="dt-col-actions">
                        <div class="dt-menu" data-dt-menu>
                            <button type="button" class="dt-menu-toggle" data-dt-menu-toggle
                                    aria-haspopup="menu" aria-expanded="false"
                                    aria-label="@L["Actions for {0}", $"{patient.FirstName} {patient.LastName}"]">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.75" /><circle cx="12" cy="12" r="1.75" /><circle cx="12" cy="19" r="1.75" /></svg>
                            </button>
                            <div class="dt-menu-list" role="menu" hidden>
                                <a role="menuitem" class="dt-menu-item" asp-action="Detail" asp-route-id="@patient.PatientId">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                                    @L["View"]
                                </a>
                                <button type="button" role="menuitem" class="dt-menu-item"
                                        onclick="openEditPatientModal('@patient.PatientId', this)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z" /></svg>
                                    @L["Edit"]
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            }

            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_DataTableFooter", new PhysioLink.AdminPanel.ViewModels.Shared.DataTableFooterViewModel
    {
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        ItemCount = Model.Patients.Count,
        Pagination = Model.Pagination
    })
</div>


@* ── Create Patient Modal (shared partial — also used on Therapist detail) ─── *@
@await Html.PartialAsync("_CreatePatientModal", new PhysioLink.AdminPanel.ViewModels.CreatePatientModalViewModel
{
    Therapists = Model.Therapists
})

@* ── Edit Patient Modal ───────────────────────────────────────────────────
   One shared dialog for the whole list — each row's data is fetched on open
   (Patients/GetById) rather than server-rendering one modal per row, since
   the list can hold many patients and duplicate DOM ids would collide. ── *@
<div class="modal-overlay" id="editPatientModal" aria-modal="true" role="dialog" aria-labelledby="editPatientModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="editPatientModalTitle">@L["Edit Patient"]</h2>
                <p class="modal-subtitle">@L["Update this patient's details."]</p>
            </div>
            <button type="button" class="modal-close" onclick="closeEditPatientModal()" aria-label="@L["Close"]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Edit" asp-controller="Patients" class="modal-form" id="editPatientForm" novalidate>
            @Html.AntiForgeryToken()
            <div class="alert alert-danger form-error-banner" role="alert" hidden></div>
            <input type="hidden" id="editPatientRouteId" name="id" value="" />
            <input type="hidden" id="editPatientId" name="PatientId" value="" />
            <input type="hidden" id="editPatientIsActive" name="IsActive" value="true" />

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="edit-FirstName">@L["First name"]</label>
                    <input type="text" id="edit-FirstName" name="FirstName" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-LastName">@L["Last name"]</label>
                    <input type="text" id="edit-LastName" name="LastName" class="form-input" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-Username">@L["Username"]</label>
                <input type="text" id="edit-Username" name="Username" class="form-input" autocomplete="off" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-Email">
                    @L["Email"] <span class="label-optional">@L["(optional)"]</span>
                </label>
                <input type="email" id="edit-Email" name="Email" class="form-input" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-PhoneNumber">@L["Phone"]</label>
                <input type="text" id="edit-PhoneNumber" name="PhoneNumber" class="form-input" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-Diagnosis">@L["Diagnosis"]</label>
                <textarea id="edit-Diagnosis" name="Diagnosis" class="form-input" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-TherapistId">
                    @L["Assigned Therapist"] <span class="label-optional">@L["(optional)"]</span>
                </label>
                <select id="edit-TherapistId" name="TherapistId" class="form-input">
                    <option value="">@L["— Unassigned —"]</option>
                    @foreach (var t in Model.Therapists)
                    {
                        <option value="@t.Id">@t.FirstName.Trim() @t.LastName.Trim()</option>
                    }
                </select>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeEditPatientModal()">@L["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L["Save Changes"]</button>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var editModal = document.getElementById('editPatientModal');
        var editForm  = document.getElementById('editPatientForm');
        if (!editModal || !editForm) return;

        function reportLoadFailure() {
            window.plForm.showFormError(editModal, @Json.Serialize(L["Could not load this patient. Check your connection and try again."].Value));
            editModal.classList.add('modal-visible');
            window.plModal.opened(editModal);
        }

        async function openEditPatientModal(patientId, trigger) {
            window.plForm.clearErrors(editModal);
            var stopLoading = window.plLoading.start(trigger);
            try {
                var response = await fetch('/Patients/GetById/' + encodeURIComponent(patientId));
                if (!response.ok) { reportLoadFailure(); return; }
                var data = await response.json();
                if (data.error) { reportLoadFailure(); return; }

                document.getElementById('editPatientRouteId').value = data.patientId;
                document.getElementById('editPatientId').value      = data.patientId;
                document.getElementById('editPatientIsActive').value = data.isActive;
                document.getElementById('edit-FirstName').value     = data.firstName || '';
                document.getElementById('edit-LastName').value      = data.lastName  || '';
                document.getElementById('edit-Username').value      = data.username  || '';
                document.getElementById('edit-Email').value         = data.email     || '';
                document.getElementById('edit-PhoneNumber').value   = data.phoneNumber || '';
                document.getElementById('edit-Diagnosis').value     = data.diagnosis || '';
                document.getElementById('edit-TherapistId').value   = data.therapistId || '';

                editModal.classList.add('modal-visible');
                window.plModal.opened(editModal);
            } catch (err) {
                console.error('[edit-patient]', err);
                reportLoadFailure();
            } finally {
                stopLoading();
            }
        }

        function closeEditPatientModal() {
            editModal.classList.remove('modal-visible');
            window.plModal.closed(editModal);
        }

        // Deliberately no overlay-click-to-close: an admin mid-form shouldn't lose
        // their entered data from a stray click. Close only via the X or Cancel.

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && editModal.classList.contains('modal-visible')) {
                closeEditPatientModal();
            }
        });

        // Client-side validation — each missing field says so under itself,
        // and focus lands on the first one that needs fixing.
        editForm.addEventListener('submit', function (e) {
            var ok = window.plForm.requireFields(editForm, [
                ['edit-FirstName', @Json.Serialize(L["First name"].Value)],
                ['edit-LastName', @Json.Serialize(L["Last name"].Value)],
                ['edit-Username', @Json.Serialize(L["Username"].Value)],
                ['edit-PhoneNumber', @Json.Serialize(L["Phone"].Value)],
                ['edit-Diagnosis', @Json.Serialize(L["Diagnosis"].Value)]
            ]);
            if (!ok) e.preventDefault();
        });

        window.openEditPatientModal  = openEditPatientModal;
        window.closeEditPatientModal = closeEditPatientModal;
    })();
</script>

@* ── Patient created (success popup, sweetalert-export/) ────────────────────
   Shown once after a patient is created: animated success icon, "Patient
   created", then the username and temporary password. The values are rendered
   by Razor (HTML-encoded) into a template, then shown with Swal.fire. *@
@if (showCredentials)
{
    <template id="patientCreatedCredentials">
        <dl class="swal-credentials">
            <div class="swal-credential">
                <dt>@L["Username"]</dt>
                <dd dir="ltr">@createdUsername</dd>
            </div>
            <div class="swal-credential">
                <dt>@L["Temporary Password"]</dt>
                <dd dir="ltr" class="swal-credential-password">@createdPassword</dd>
            </div>
        </dl>
    </template>
    <script>
        // Runs after the deferred sweetalert.js has loaded.
        document.addEventListener('DOMContentLoaded', function () {
            window.Swal.fire({
                icon: 'success',
                title: @Json.Serialize(L["Patient created"].Value),
                html: document.getElementById('patientCreatedCredentials').innerHTML,
                confirmButtonText: @Json.Serialize(L["Done"].Value),
                // Close only on purpose (Done or Esc), not on a stray click
                // while the password still needs to be copied.
                allowOutsideClick: false
            });
        });
    </script>
}

@* ── Patient deactivated (success popup, sweetalert-export/) ────────────────
   Shown once after a patient is deactivated: animated success check, "Patient
   deactivated", then a summary of what changed. Values are rendered by Razor
   (HTML-encoded) into a template, then shown with Swal.fire. *@
@if (showDeactivated)
{
    <template id="patientDeactivatedSummary">
        <dl class="swal-credentials">
            @if (deactivatedName!.Length > 0)
            {
                <div class="swal-credential">
                    <dt>@L["Patient"]</dt>
                    <dd>@deactivatedName</dd>
                </div>
            }
            <div class="swal-credential">
                <dt>@L["Status"]</dt>
                <dd><span class="swal-pill swal-pill-inactive">@L["Inactive"]</span></dd>
            </div>
            <div class="swal-credential">
                <dt>@L["App access"]</dt>
                <dd>@L["Revoked"]</dd>
            </div>
        </dl>
        <p class="swal-note">@L["Records and history are retained."]</p>
    </template>
    <script>
        // Runs after the deferred sweetalert.js has loaded.
        document.addEventListener('DOMContentLoaded', function () {
            window.Swal.fire({
                icon: 'success',
                title: @Json.Serialize(L["Patient deactivated"].Value),
                html: document.getElementById('patientDeactivatedSummary').innerHTML,
                confirmButtonText: @Json.Serialize(L["Done"].Value)
            });
        });
    </script>
}
