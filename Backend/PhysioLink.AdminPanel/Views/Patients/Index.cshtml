@model PhysioLink.AdminPanel.ViewModels.PatientListViewModel
@{

    ViewData["Title"] = "Patients";
    ViewData["ActivePage"] = "Patients";


    var createdName     = TempData["PatientCreatedName"]     as string;
    var createdUsername = TempData["PatientCreatedUsername"] as string;
    var createdPassword = TempData["PatientCreatedPassword"] as string;
    var showCredentials = !string.IsNullOrEmpty(createdPassword);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Patients</h1>
        <p class="page-sub">
            @Model.TotalCount patients
        </p>
    </div>
    <button type="button" onclick="openPatientModal()"
            class="btn btn-primary">
        + New Patient
    </button>
</div>

@* Search + Filter bar *@
<form method="get" asp-action="Index" class="toolbar">
    <div class="search-field">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text"
               name="searchQuery"
               value="@Model.SearchQuery"
               placeholder="Search by name..."
               class="search-input"
               autocomplete="off" />
    </div>

    <select name="therapistId"
            onchange="this.form.submit()"
            class="filter-select"
            aria-label="Filter by therapist">
        <option value="">All Therapists</option>
        @foreach (var therapist in Model.Therapists)
        {
            if (therapist.Id == Model.SelectedTherapistId)
            {
                <option value="@therapist.Id" selected>@therapist.FirstName.Trim() @therapist.LastName.Trim()</option>
            }
            else
            {
                <option value="@therapist.Id">@therapist.FirstName.Trim() @therapist.LastName.Trim()</option>
            }
        }
    </select>

    <button type="submit" class="btn btn-ghost">
        Search
    </button>
</form>

@* Patients table *@
<div class="card card-flush">
    <table class="data-table">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Therapist</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.Patients.Count == 0)
            {
                <tr>
                    <td colspan="5" class="empty-row">
                        No patients found.
                    </td>
                </tr>
            }

            @foreach (var patient in Model.Patients)
            {
                <tr>
                    <td>
                        <div class="cell-person">
                            <svg class="patient-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <span class="name">
                                @patient.FirstName @patient.LastName
                            </span>
                        </div>
                    </td>
                    <td class="muted-cell">
                        @(patient.TherapistName ?? "Unassigned")
                    </td>
                    <td class="muted-cell">
                        @patient.PhoneNumber
                    </td>
                    <td>
                        @await Html.PartialAsync("_StatusBadge", patient.IsActive ? "Active" : "Inactive")
                    </td>
                    <td>
                        <div class="cell-actions">
                            <a asp-action="Detail" asp-route-id="@patient.PatientId"
                               class="btn btn-ghost btn-sm">
                                View
                            </a>
                            <button type="button" class="btn btn-ghost btn-sm"
                                    onclick="openEditPatientModal('@patient.PatientId')">
                                Edit
                            </button>
                        </div>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", Model.Pagination)


@* ── Create Patient Modal (shared partial — also used on Therapist detail) ─── *@
@await Html.PartialAsync("_CreatePatientModal", new PhysioLink.AdminPanel.ViewModels.CreatePatientModalViewModel
{
    Therapists = Model.Therapists
})

@* ── Edit Patient Modal ───────────────────────────────────────────────────
   One shared dialog for the whole list — each row's data is fetched on open
   (Patients/GetById) rather than server-rendering one modal per row, since
   the list can hold many patients and duplicate DOM ids would collide. ── *@
<div class="modal-overlay" id="editPatientModal" aria-modal="true" role="dialog" aria-labelledby="editPatientModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="editPatientModalTitle">Edit Patient</h2>
                <p class="modal-subtitle">Update this patient's details.</p>
            </div>
            <button type="button" class="modal-close" onclick="closeEditPatientModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <form method="post" asp-action="Edit" asp-controller="Patients" class="modal-form" id="editPatientForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editPatientRouteId" name="id" value="" />
            <input type="hidden" id="editPatientId" name="PatientId" value="" />
            <input type="hidden" id="editPatientIsActive" name="IsActive" value="true" />

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="edit-FirstName">First Name</label>
                    <input type="text" id="edit-FirstName" name="FirstName" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-LastName">Last Name</label>
                    <input type="text" id="edit-LastName" name="LastName" class="form-input" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-Username">Username</label>
                <input type="text" id="edit-Username" name="Username" class="form-input" autocomplete="off" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-Email">
                    Email <span class="label-optional">(optional)</span>
                </label>
                <input type="email" id="edit-Email" name="Email" class="form-input" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-PhoneNumber">Phone</label>
                <input type="text" id="edit-PhoneNumber" name="PhoneNumber" class="form-input" />
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-Diagnosis">Diagnosis</label>
                <textarea id="edit-Diagnosis" name="Diagnosis" class="form-input" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label" for="edit-TherapistId">
                    Assigned Therapist <span class="label-optional">(optional)</span>
                </label>
                <select id="edit-TherapistId" name="TherapistId" class="form-input">
                    <option value="">— Unassigned —</option>
                    @foreach (var t in Model.Therapists)
                    {
                        <option value="@t.Id">@t.FirstName.Trim() @t.LastName.Trim()</option>
                    }
                </select>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="closeEditPatientModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var editModal = document.getElementById('editPatientModal');
        var editForm  = document.getElementById('editPatientForm');
        if (!editModal || !editForm) return;

        async function openEditPatientModal(patientId) {
            try {
                var response = await fetch('/Patients/GetById/' + encodeURIComponent(patientId));
                if (!response.ok) { alert('Could not load patient.'); return; }
                var data = await response.json();
                if (data.error) { alert('Could not load patient.'); return; }

                document.getElementById('editPatientRouteId').value = data.patientId;
                document.getElementById('editPatientId').value      = data.patientId;
                document.getElementById('editPatientIsActive').value = data.isActive;
                document.getElementById('edit-FirstName').value     = data.firstName || '';
                document.getElementById('edit-LastName').value      = data.lastName  || '';
                document.getElementById('edit-Username').value      = data.username  || '';
                document.getElementById('edit-Email').value         = data.email     || '';
                document.getElementById('edit-PhoneNumber').value   = data.phoneNumber || '';
                document.getElementById('edit-Diagnosis').value     = data.diagnosis || '';
                document.getElementById('edit-TherapistId').value   = data.therapistId || '';

                editModal.classList.add('modal-visible');
            } catch (err) {
                console.error('[edit-patient]', err);
                alert('Could not load patient.');
            }
        }

        function closeEditPatientModal() {
            editModal.classList.remove('modal-visible');
        }

        // Deliberately no overlay-click-to-close: an admin mid-form shouldn't lose
        // their entered data from a stray click. Close only via the X or Cancel.

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && editModal.classList.contains('modal-visible')) {
                closeEditPatientModal();
            }
        });

        // Client-side validation
        editForm.addEventListener('submit', function (e) {
            var first    = document.getElementById('edit-FirstName').value.trim();
            var last     = document.getElementById('edit-LastName').value.trim();
            var username = document.getElementById('edit-Username').value.trim();
            var phone    = document.getElementById('edit-PhoneNumber').value.trim();
            var diag     = document.getElementById('edit-Diagnosis').value.trim();

            if (!first || !last || !username || !phone || !diag) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });

        window.openEditPatientModal  = openEditPatientModal;
        window.closeEditPatientModal = closeEditPatientModal;
    })();
</script>

@* ── Patient Credentials Modal (shown after successful create) ────────────── *@
<div class="modal-overlay @(showCredentials ? "modal-visible" : "")" id="credentialsModal"
     aria-modal="true" role="dialog" aria-labelledby="credentialsModalTitle">
    <div class="modal">

        <div class="modal-header">
            <div class="row-lead">
                <div class="success-icon-disc">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <div>
                    <h2 class="modal-title" id="credentialsModalTitle">Patient Created</h2>
                    <p class="modal-subtitle">@createdName has been added successfully.</p>
                </div>
            </div>
            <button type="button" class="modal-close" onclick="closeCredentialsModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="modal-form">

            <div class="notice notice-warning">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <p>Save this password now — it will not be shown again.</p>
            </div>

            <div class="form-group">
                <label class="form-label">Username</label>
                <p class="static-value">@createdUsername</p>
            </div>

            <div class="form-group">
                <label class="form-label">Temporary Password</label>
                <div class="credential-box">
                    @createdPassword
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-primary" onclick="closeCredentialsModal()">Done</button>
            </div>

        </div>

    </div>
</div>

@* The New Patient dialog and its JS live in _CreatePatientModal.
   This script only drives the post-create credentials modal. *@
<script>
    (function () {
        var credentialsModal = document.getElementById('credentialsModal');
        if (!credentialsModal) return;

        function closeCredentialsModal() {
            credentialsModal.classList.remove('modal-visible');
        }

        // Deliberately no overlay-click-to-close: closing should be an explicit
        // choice (Done), not a stray click while the credentials are still visible.

        window.closeCredentialsModal = closeCredentialsModal;
    })();
</script>
