@model PhysioLink.AdminPanel.ViewModels.CreatePatientResultViewModel
@{ ViewData["Title"] = "Patient Created"; ViewData["ActivePage"] = "Patients"; }

<div style="max-width:520px; margin:0 auto;">
    <div style="background:white; border-radius:14px; border:0.5px solid #e5e5ea; padding:32px;">

        <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
            <div style="width:40px; height:40px; border-radius:50%; background:#e8f5ee; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2e7d52" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <div>
                <h2 style="font-size:1.1rem; font-weight:600; color:#323232; margin:0;">Patient Created</h2>
                <p style="font-size:13px; color:#8E8E93; margin:2px 0 0;">@Model.FullName has been added successfully.</p>
            </div>
        </div>

        <div style="background:#fff8e1; border:0.5px solid #f59e0b; border-radius:10px; padding:14px 16px; margin-bottom:24px; display:flex; gap:10px; align-items:flex-start;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" style="flex-shrink:0; margin-top:1px;"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <p style="font-size:13px; color:#92650a; margin:0; line-height:1.5;">
                Save this password now. It will not be shown again.
            </p>
        </div>

        <div style="margin-bottom:20px;">
            <p style="font-size:12px; color:#8E8E93; margin:0 0 6px;">Email</p>
            <p style="font-size:14px; color:#323232; font-weight:500; margin:0;">@Model.Email</p>
        </div>

        <div style="margin-bottom:28px;">
            <p style="font-size:12px; color:#8E8E93; margin:0 0 8px;">Temporary Password</p>
            <div style="background:#f5f5f7; border-radius:8px; padding:16px 20px; letter-spacing:0.08em; font-family:'Courier New', Courier, monospace; font-size:1.4rem; font-weight:600; color:#004AAD; word-break:break-all;">
                @Model.TemporaryPassword
            </div>
        </div>

        <a asp-action="Index"
           style="display:block; text-align:center; background:#004AAD; color:white; padding:11px 24px; border-radius:8px; text-decoration:none; font-size:14px; font-weight:500;">
            Done
        </a>

    </div>
</div>
