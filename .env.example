# Copy the variables you need into your shell (or a local, gitignored .env).
# Never put real values in this file.
#
# Note: dotnet test does not read .env files. Set the variable in your shell
# before running the tests, e.g. PowerShell:
#   $env:TEST_DB_PASSWORD="<password>"; dotnet test Backend/PhysioLink.Tests

# Password for the local dev Postgres (localhost:5433, user postgres, db PhysioLinkDb).
# Required by the DB-backed tests in Backend/PhysioLink.Tests (see TestDb.cs).
TEST_DB_PASSWORD=
